@Composable
private fun WalletStacks(ui: WalletHomeUi) {
    val art = LocalMoneyArt.current
    Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
        ui.bills.chunked(2).forEach { row ->
            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                row.forEach { BillStack(it.denomination, it.count, Modifier.weight(1f), painter = art.painter(it.denomination)) }
                if (row.size == 1) Spacer(Modifier.weight(1f))
            }
        }
        if (ui.coins.isNotEmpty()) {
            Spacer(Modifier.height(2.dp))
            SectionLabel(Strings.COINS)
            Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.Bottom) {
                ui.coins.forEach { CoinStack(it.denomination, it.count, painter = art.painter(it.denomination)) }
            }
        }
    }
}
private fun DragGhost(denomination: Denomination, drag: DragDropState) {
    val art = LocalMoneyArt.current
    val density = LocalDensity.current
    val isBill = denomination.kind == Denomination.Kind.BILL
    val width = if (isBill) GhostBillWidth else GhostCoinSize
    val height = if (isBill) GhostBillWidth / BILL_ASPECT else GhostCoinSize
    val halfW = with(density) { width.toPx() / 2f }
    val halfH = with(density) { height.toPx() / 2f }
    MoneyFace(
        denomination,
        Modifier
            .size(width, height)
            .graphicsLayer {
                val p = drag.position
                val o = drag.hostOrigin
                translationX = p.x - o.x - halfW
                translationY = p.y - o.y - halfH
                rotationZ = -5f
                scaleX = 1.08f
                scaleY = 1.08f
            },
        art.painter(denomination),
    )
}

