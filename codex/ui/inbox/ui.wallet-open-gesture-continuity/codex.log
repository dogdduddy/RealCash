@OptIn(ExperimentalCoroutinesApi::class)
class WalletOpenModelTest {
    private val clock = object : Clock { override fun now() = Instant.parse("2026-11-04T09:00:00Z") }
    private class FailingIds : IdGenerator {
        var n = 0
        var failAt = -1
        override fun next(): String { n++; check(n != failAt) { "저장 실패" }; return "open-$n" }
    }


    @Test
    fun dropsDuringWriteSaveLatestTrayInOrderBeforeNavigation() = runTest {
        val driver = DriverFactory().createDriver()
        try {
            val writes = PausedWalletWrites(StandardTestDispatcher(testScheduler))
            val data = RealCashData(driver, clock, FailingIds(), writes)
            data.wallet.receiveAllowance(mapOf(W10000 to 2, W5000 to 1), LocalDate(2026, 11, 1))
            data.settings.load()
            val model = WalletOpenModel(backgroundScope, AppEnvironment(data, Haptics.None, clock = clock))
            backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { model.ui.collect {} }
            val units = data.wallet.state.value.inWallet
            val expected = listOf(units[2].id, units[1].id)
            var navigations = 0
            model.setOnTray(units[0].id, true)
            writes.paused = true
            model.confirm {
                assertEquals(expected, data.wallet.state.value.activeHand?.unitIds)
                navigations++
            }
            runCurrent()
            assertTrue(model.submitting.value)
            assertTrue(data.wallet.state.value.inHand.isEmpty(), "the first write is suspended")
            model.setOnTray(units[2].id, true)
            model.setOnTray(units[0].id, false)
            model.setOnTray(units[1].id, true)
            runCurrent()
            assertEquals(expected, model.ui.value.inHand.map { it.id })
            // Even if another debounce would have elapsed, the in-flight snapshot must survive.
            advanceTimeBy(500); runCurrent()
            assertEquals(0, navigations)
            writes.resume()
            runCurrent()
            assertEquals(expected, data.wallet.state.value.activeHand?.unitIds)
            assertEquals(expected, model.ui.value.inHand.map { it.id })
            assertEquals(2, data.wallet.history.value.filterIsInstance<MovedToHand>().size)
            assertEquals(1, navigations)
            assertFalse(model.submitting.value)
            assertFalse(model.ui.value.changed)
            assertTrue(data.wallet.state.value.invariantViolations().isEmpty())
            val loaded = RealCashData(driver, clock, FailingIds(), EmptyCoroutineContext).wallet.load()
            assertEquals(expected, loaded.activeHand?.unitIds)
        } finally { driver.close() }
    }

    @Test
    fun returningLastUnitDuringWriteSavesEmptyTrayAndThenNavigates() = runTest {
        val driver = DriverFactory().createDriver()
        try {
            val writes = PausedWalletWrites(StandardTestDispatcher(testScheduler))
            val data = RealCashData(driver, clock, FailingIds(), writes)
            data.wallet.receiveAllowance(mapOf(W10000 to 1), LocalDate(2026, 11, 1))
            data.settings.load()
            val model = WalletOpenModel(backgroundScope, AppEnvironment(data, Haptics.None, clock = clock))
            val id = data.wallet.state.value.inWallet.single().id
            model.setOnTray(id, true)
            writes.paused = true
            model.confirm()
            runCurrent()
        }
        val coinSlots = scatter.associate { coin ->
            allCoins[coin.index].id to WalletRect(coin.x - coin.diameter / 2f, coin.y - coin.diameter / 2f, coin.diameter, coin.diameter)
        }
        // Only positions, never ownership. Discarded on the next screen visit.
        val trayCoins = remember(seed) { mutableStateMapOf<CashUnitId, Offset>() }
        val traySlots = traySlots(ui.inHand, layout.trayInner, trayCoins)
        val picked = physics.picked
        val pickedId = picked?.unit?.id // start/end only, not per-pointer coordinates
        val overTray = physics.overTray // edge transitions only
        val hits = buildList {
            groups.forEachIndexed { index, group ->
                add(CashHit(bills.getValue(group.denomination).last(), false, pocketBillHitBounds(groups, index),
                    WalletRect(group.frontLeft, group.top, group.billWidth, group.billHeight)))
            }
            coins.forEach { coin -> coinSlots[coin.id]?.let { add(CashHit(coin, false, it, it)) } }
            ui.inHand.forEach { unit -> traySlots[unit.id]?.let { add(CashHit(unit, true, it, it)) } }
        }
        val sway = groups.flatMap { group ->
            (0 until group.visibleCount).map { i ->
                val animation = key(group.denomination, i) { remember { BillSway(scope) } }
                WalletRect(group.left + i * group.fanStep, group.top, group.billWidth, group.billHeight) to animation
            }
        }
        val currentEnabled = rememberUpdatedState(!submitting)
        val currentHits = rememberUpdatedState(hits)
        val currentPocket = rememberUpdatedState(layout.pocket)
        val currentSway = rememberUpdatedState(sway)
        val release by rememberUpdatedState<(Boolean) -> Unit>({ cancelled ->
            val pick = physics.picked
            if (pick != null && !physics.settling) {
                val walletDrop = wallet.copy(width = maxOf(wallet.right, layout.coins.right) - wallet.left)
                val destination = pick.destination(physics.position, layout.trayInner, walletDrop, cancelled)
                val target = when (destination) {
                    DropDestination.SOURCE -> pick.source
                    DropDestination.TRAY -> {
                        if (!pick.isBill) trayCoins[pick.unit.id] = physics.position
                        val units = if (pick.fromTray) ui.inHand else ui.inHand + pick.unit
                        traySlots(units, layout.trayInner, trayCoins).getValue(pick.unit.id)
                    }
                    DropDestination.WALLET -> {
                        trayCoins.remove(pick.unit.id)
                        if (pick.isBill) {
                            val counts = (ui.inWallet + pick.unit).filter { it.denomination.kind == Denomination.Kind.BILL }.groupingBy { it.denomination }.eachCount()
                            val group = pocketBillGroups(counts, layout.pocket).first { it.denomination == pick.unit.denomination }
                            WalletRect(group.frontLeft, group.top, group.billWidth, group.billHeight)
                        } else coinSlots[pick.unit.id] ?: pick.source
                    }
                }
                if (destination == DropDestination.SOURCE) haptics.tap() else {
                    haptics.success()
                    onDrop(pick.unit.id, destination == DropDestination.TRAY)
                }
                physics.settle(pick.flight(destination, target))
            }
        })
        // Full-screen gesture surface has no scrolling. Controls remain ordinary buttons above it.
        Box(Modifier.fillMaxSize().walletGestures(currentEnabled, density, currentHits, currentPocket, currentSway, physics, haptics) { release(it) }) {
            Image(walletPainter, "열린 지갑", Modifier.rect(wallet), contentScale = ContentScale.FillBounds)
            Image(painterResource(Res.drawable.tray), "꺼낸 돈을 두는 접시",
                Modifier.rect(layout.tray).graphicsLayer { alpha = if (overTray) 1f else 0.94f }, contentScale = ContentScale.FillBounds)

