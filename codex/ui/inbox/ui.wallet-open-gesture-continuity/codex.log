        val bill = CashUnit(CashUnitId(\"bill\"), W10000, CashUnitState.IN_WALLET,
            Instant.parse(\"2026-11-04T09:00:00Z\"), CashUnitSource.ALLOWANCE)
        val submitting = mutableStateOf(true)
