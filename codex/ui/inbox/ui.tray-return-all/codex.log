class WalletOpenNavigationTest {
    @Test
    fun longPressFrontBillDropReturnAndPaymentEntryWork() = runBlocking {
        val driver = DriverFactory().createDriver()
        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
        val clock = object : Clock { override fun now() = Instant.parse("2026-11-04T09:00:00Z") }
        var pickups = 0
        var successes = 0
        var taps = 0
        val haptics = object : Haptics {
            override fun pickUp() { pickups++ }
            override fun success() { successes++ }
            override fun tap() { taps++ }
        }
        try {
            val data = RealCashData(driver, clock, SequentialIdGenerator(), EmptyCoroutineContext)
            data.wallet.receiveAllowance(mapOf(W50000 to 1, W10000 to 3, W5000 to 1, W1000 to 1, C500 to 1), LocalDate(2026, 11, 1))
            val app = AppState(AppEnvironment(data, haptics, clock = clock), scope)
            app.openWallet()
            val scene = ImageComposeScene(780, 1688, Density(2f), coroutineContext = coroutineContext) { RealCashTheme { RealCashRoot(app) } }
            var time = 0L
            fun settle() { repeat(35) { scene.render(time); time += 50_000_000L } }
            fun pointer(type: PointerEventType, point: Offset) { scene.sendPointerEvent(type, point * 2f) }
            fun tap(point: Offset) { pointer(PointerEventType.Press, point); pointer(PointerEventType.Release, point); settle() }
            suspend fun drag(from: Offset, to: Offset, expectPick: Boolean = true, onDropped: () -> Unit = {}) {
                pointer(PointerEventType.Press, from)
                delay(450)
                scene.render(time); time += 50_000_000L
                assertEquals(expectPick, app.walletOpen.physics.picked != null)
                pointer(PointerEventType.Move, to)
                scene.render(time); time += 50_000_000L
                pointer(PointerEventType.Release, to)
                onDropped()
                settle()
            }
            try {
                settle()
                val layout = WalletOpenLayout.calculate(390f, 844f)
                val group = pocketBillGroups(mapOf(W50000 to 1, W10000 to 3, W5000 to 1, W1000 to 1), layout.pocket)[1]
                val point = Offset(group.openingX + 2f, group.top + 3f)
                val frontId = data.wallet.state.value.inWallet.first { it.denomination == W10000 }.id
                // A short tap and a leather long press cannot take paper out.
                tap(point)
                assertEquals(Won.ZERO, app.walletOpen.ui.value.handTotal)
                drag(Offset(layout.wallet.left + 2f, layout.wallet.center.y), layout.trayInner.center, expectPick = false)
                assertEquals(Won.ZERO, app.walletOpen.ui.value.handTotal)
                drag(point, layout.trayInner.center)
                assertEquals(Won(10_000), app.walletOpen.ui.value.handTotal)
                assertEquals(frontId, app.walletOpen.ui.value.inHand.single().id)
                delay(350); settle()
                assertEquals(listOf(frontId), data.wallet.state.value.activeHand?.unitIds)
                assertEquals(1, successes)
                // Off-tray release springs back to the original tray slot without changing the hand.
                val trayPoint = traySlots(app.walletOpen.ui.value.inHand, layout.trayInner, emptyMap()).getValue(frontId).center
                drag(trayPoint, Offset(5f, 280f))
                assertEquals(listOf(frontId), data.wallet.state.value.activeHand?.unitIds)
                assertNull(app.walletOpen.physics.picked)
                drag(trayPoint, layout.wallet.center)
                delay(350); settle()
                assertNull(data.wallet.state.value.activeHand)
                assertEquals(Won.ZERO, app.walletOpen.ui.value.handTotal)
                assertEquals(3, pickups)
                assertEquals(2, successes)
                assertTrue(taps >= 2)
                // A coin stays at the precise release point through saving and can return to its scatter slot.
                val coin = data.wallet.state.value.inWallet.single { it.denomination == C500 }
                val coinPosition = CoinScatter.place(app.walletOpen.seed, 1, layout.coins).single()
                val coinSource = Offset(coinPosition.x, coinPosition.y)
                val coinDrop = Offset(layout.trayInner.right - 25f, layout.trayInner.top + 25f)
                drag(coinSource, coinDrop, onDropped = {
                    assertEquals(coinDrop, app.walletOpen.physics.flight?.target?.center)
                    assertEquals(0f, app.walletOpen.physics.flight?.rotation)
                })
                delay(350); settle()
                assertEquals(listOf(coin.id), data.wallet.state.value.activeHand?.unitIds)
                drag(coinDrop, coinSource)
                delay(350); settle()
                assertNull(data.wallet.state.value.activeHand)
                assertTrue(app.walletOpen.ui.value.inHand.isEmpty())
                tap(Offset(348f, layout.tray.bottom + 22f))
                assertTrue(app.walletOpen.paymentInfoOpen.value)
                tap(Offset(292f, 490f))
                assertTrue(app.manualSheetOpen)
                assertFalse(app.walletOpen.paymentInfoOpen.value)
                assertEquals(Won.ZERO, data.wallet.state.value.inHand.total())
            } finally { scene.close() }
        } finally { scope.cancel(); driver.close() }
    }
}
package com.jim.realcash.ui.walletopen

import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.ui.money.billAspectRatio

/** All coordinates are logical dp, independent of Compose measurement and device density. */
data class WalletRect(val left: Float, val top: Float, val width: Float, val height: Float) {
    val right get() = left + width
    val bottom get() = top + height
    fun inner(left: Float, top: Float, right: Float, bottom: Float) =
        WalletRect(this.left + width * left, this.top + height * top, width * (right - left), height * (bottom - top))
}

/** Reviewed assets/manifest.json wallet.open.c.opening; artwork is always shown whole. */
object WalletOpening {
    const val X = 0.975f
    const val TOP = 0.03f
    const val BOTTOM = 0.97f
    const val HEAD_STEP = 24f
    const val PAPER_STEP = 1.5f
    const val MAX_STACK_OFFSET = 12f
    const val HIT_PADDING = 8f

    fun contains(wallet: WalletRect, point: androidx.compose.ui.geometry.Offset): Boolean =
        point.x >= wallet.left + wallet.width * X &&
            point.y in (wallet.top + wallet.height * TOP)..(wallet.top + wallet.height * BOTTOM)
}

data class PocketBillGroup(
    val denomination: Denomination,
    val count: Int,
    val left: Float,
    val top: Float,
    val billWidth: Float,
    val billHeight: Float,
    val fanStep: Float,
    val openingX: Float,
    val exposedWidth: Float,
) {
    val visibleCount get() = count
    val right get() = openingX + exposedWidth + (count - 1) * fanStep
    val frontLeft get() = left
    val exposedHeight get() = billHeight
    val bottom get() = top + billHeight + (count - 1) * fanStep
    val face get() = WalletRect(left, top, billWidth, billHeight)

    /** Back papers stay in their slots while the front paper is held. */
    fun drawOrder(frontPicked: Boolean = false): List<Int> =
        (count - 1 downTo if (frontPicked) 1 else 0).toList()

    fun exposedBillBounds(index: Int): WalletRect = WalletRect(
        openingX, top + index * fanStep, exposedWidth + index * fanStep, billHeight,
    )
}

data class WalletOpenLayout(val wallet: WalletRect, val pocket: WalletRect, val tray: WalletRect, val trayInner: WalletRect, val coins: WalletRect) {
    companion object {
        fun calculate(width: Float, height: Float): WalletOpenLayout {
            require(width > 0 && height > 0)
            val landscape = width > height
            val trayWidth = minOf(width * (if (landscape) 0.43f else 0.92f), height * (if (landscape) 0.30f else 0.22f) * 1024f / 427f)
            val tray = WalletRect(if (landscape) 12f else (width - trayWidth) / 2f, 78f, trayWidth, trayWidth * 427f / 1024f)
            val walletHeight = if (landscape) height - tray.top - 12f
                else minOf(height * 0.55f, height - tray.bottom - 42f)
            val walletWidth = walletHeight * 640f / 1230f
            val wallet = WalletRect(if (landscape) tray.right + 24f else 12f,
                if (landscape) tray.top else minOf(height - walletHeight - 12f, tray.bottom + 104f), walletWidth, walletHeight)
            // pocket.left is the vertical clipping line, not the hidden left edge of a full note.
            val coinLeft = width - CoinScatter.EDGE_MARGIN - CoinScatter.MAX_DIAMETER - CoinScatter.JITTER
            val pocket = WalletRect(wallet.left + wallet.width * WalletOpening.X,
                wallet.top + wallet.height * WalletOpening.TOP,
                coinLeft - CoinScatter.GAP - (wallet.left + wallet.width * WalletOpening.X),
                wallet.height * (WalletOpening.BOTTOM - WalletOpening.TOP))
            val all = pocketBillGroups(Denomination.descending.filter { it.kind == Denomination.Kind.BILL }
                .associateWith { 30 }, pocket)
            val coinStripLeft = maxOf(wallet.right, all.maxOf { it.right }) + CoinScatter.GAP
            // Include horizontal jitter in the strip and leave room below for the overflow button.
            return WalletOpenLayout(wallet, pocket, tray, tray.inner(0.05f, 0.13f, 0.95f, 0.90f),
                WalletRect(coinStripLeft, pocket.top,
                    width - CoinScatter.EDGE_MARGIN + CoinScatter.JITTER - coinStripLeft,
                    height - 56f - pocket.top))
        }
    }
}

/** One flat bundle: expensive notes underneath, with fixed denomination heads and real length ratios. */
fun pocketBillGroups(counts: Map<Denomination, Int>, pocket: WalletRect): List<PocketBillGroup> {
    if (pocket.width <= 0f || pocket.height <= 0f) return emptyList()
    val walletHeight = pocket.height / (WalletOpening.BOTTOM - WalletOpening.TOP)
    // Fit the lowest denomination and its deepest stack inside the pocket. Coins now sit beside it.
    val longest = minOf(walletHeight * 0.8f,
        (pocket.height - 3f * WalletOpening.HEAD_STEP - WalletOpening.MAX_STACK_OFFSET) / (136f / 154f),
        (pocket.width - WalletOpening.MAX_STACK_OFFSET) / 0.55f * Denomination.W50000.billAspectRatio,
    ).coerceAtLeast(1f)
    val shortEdge = longest / Denomination.W50000.billAspectRatio
    return Denomination.descending.filter { it.kind == Denomination.Kind.BILL }.mapIndexedNotNull { index, d ->
        val count = counts[d] ?: 0
        if (count <= 0) return@mapIndexedNotNull null
        val fraction = when (d) {
            Denomination.W1000 -> 0.55f
            Denomination.W5000 -> 0.45f
            Denomination.W10000 -> 0.35f
            else -> 0.25f
        }
        val exposed = shortEdge * fraction
        val step = if (count == 1) 0f else minOf(WalletOpening.PAPER_STEP, WalletOpening.MAX_STACK_OFFSET / (count - 1))
        PocketBillGroup(d, count, pocket.left + exposed - shortEdge,
            pocket.top + index * WalletOpening.HEAD_STEP, shortEdge, shortEdge * d.billAspectRatio,
            step, pocket.left, exposed)
    }
}

/** Only the stepped head is pickable below another denomination; the top group exposes its face. */
fun pocketBillHitBounds(groups: List<PocketBillGroup>, index: Int): WalletRect {
    val group = groups[index]
    val bottom = groups.getOrNull(index + 1)?.top ?: group.bottom
    return WalletRect(group.openingX, group.top - WalletOpening.HIT_PADDING,
        group.right - group.openingX, bottom - group.top + 2f * WalletOpening.HIT_PADDING)
}

/** Subtract front papers to give swipe contact only to paper the finger can actually see. */
internal fun visiblePaperBounds(groups: List<PocketBillGroup>): List<Triple<Denomination, Int, List<WalletRect>>> {
    val paint = groups.flatMap { group -> group.drawOrder().map { Triple(group.denomination, it, group.exposedBillBounds(it)) } }
    return paint.mapIndexed { i, paper ->
        var pieces = listOf(paper.third)
        paint.drop(i + 1).forEach { cover -> pieces = pieces.flatMap { it.subtract(cover.third) } }
        Triple(paper.first, paper.second, pieces)
    }
}

private fun WalletRect.subtract(cover: WalletRect): List<WalletRect> {
    val l = maxOf(left, cover.left); val r = minOf(right, cover.right)
    val t = maxOf(top, cover.top); val b = minOf(bottom, cover.bottom)
    if (l >= r || t >= b) return listOf(this)
    return listOf(WalletRect(left, top, width, t - top), WalletRect(left, b, width, bottom - b),
        WalletRect(left, t, l - left, b - t), WalletRect(r, t, right - r, b - t))
        .filter { it.width > 0f && it.height > 0f }
}

/** Horizontal tray faces overlap by a fixed pitch, with coins following the final bill edge. */
fun trayBillBounds(denominations: List<Denomination>, area: WalletRect): List<WalletRect> {
    val height = area.height * 0.62f
    return denominations.mapIndexed { index, d ->
        WalletRect(area.left + index * 24f, area.top + (area.height - height) / 2f,
            height * d.billAspectRatio, height)
    }
}
package com.jim.realcash.domain.ledger

import com.jim.realcash.domain.model.CashUnit
import com.jim.realcash.domain.model.CashUnitId
import com.jim.realcash.domain.model.CashUnitState
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.domain.model.DetectedPayment
import com.jim.realcash.domain.model.Hand
import com.jim.realcash.domain.model.PaymentId
import com.jim.realcash.domain.model.Settlement
import com.jim.realcash.domain.model.Won
import com.jim.realcash.domain.model.total

/** Wallet state derived from the ledger. Never stored as the source of truth. */
data class WalletState(
    /** Every unit ever seen, in any state (except units removed by [Adjusted]). */
    val units: Map<CashUnitId, CashUnit>,
    /** The currently active hand, if any. */
    val activeHand: Hand?,
    /** Detected payments waiting for confirmation or settlement. */
    val pendingPayments: Map<PaymentId, DetectedPayment>,
    /** Settlements in the order they were applied. */
    val settlements: List<Settlement>,
    /**
     * Identifiers of every applied event.
     *
     * NOTE: not in the original spec; added so that applying the same event twice is always rejected,
     * even for events whose effect would otherwise be a no-op.
     */
    val appliedEventIds: Set<String> = emptySet(),
) {
    /** Units currently in the wallet. */
    val inWallet: List<CashUnit> get() = units.values.filter { it.state == CashUnitState.IN_WALLET }

    /** Units currently held in the active hand. */
    val inHand: List<CashUnit> get() = units.values.filter { it.state == CashUnitState.IN_HAND }

    /** Money the user still owns in cash: wallet plus hand. Never negative. */
    val balance: Won get() = inWallet.total() + inHand.total()

    /** Number of units per denomination in the given [state], largest denomination first, zeros omitted. */
    fun countsByDenomination(state: CashUnitState): Map<Denomination, Int> {
        val counts = units.values.filter { it.state == state }.groupingBy { it.denomination }.eachCount()
        return Denomination.descending.filter { it in counts }.associateWith { counts.getValue(it) }
    }

    /**
     * Returns the list of violated invariants (empty when the state is consistent).
     *
     * The reducer keeps these invariants by construction; this full check is O(n) and meant for tests
     * and debug assertions rather than for every event.
     */
    fun invariantViolations(): List<String> {
        val problems = mutableListOf<String>()
        units.forEach { (key, unit) ->
            if (key != unit.id) problems += "unit stored under foreign key: $key -> ${unit.id}"
        }
        val handIds = activeHand?.unitIds.orEmpty()
        if (handIds.size != handIds.toSet().size) problems += "active hand lists a unit twice"
        val inHandIds = inHand.map { it.id }.toSet()
        if (inHandIds != handIds.toSet()) {
            problems += "IN_HAND units $inHandIds differ from active hand units ${handIds.toSet()}"
        }
        if (activeHand != null && handIds.isEmpty()) problems += "active hand holds no units"
        if (balance.value < 0) problems += "negative balance $balance"
        settlements.forEach { s ->
            if (s.shortfall.value < 0) problems += "negative shortfall in ${s.paymentId}"
            s.paidUnitIds.forEach { id ->
                if (units[id]?.state != CashUnitState.SPENT) problems += "paid unit $id is not SPENT"
            }
        }
        if (settlements.map { it.paymentId }.toSet().size != settlements.size) problems += "payment settled twice"
        settlements.forEach { s ->
            if (s.paymentId in pendingPayments) problems += "settled payment ${s.paymentId} still pending"
        }
        return problems
    }

    /** Factory for the initial state. */
    companion object {
        /** A wallet before any event has been applied. */
        val EMPTY: WalletState = WalletState(
            units = emptyMap(),
            activeHand = null,
            pendingPayments = emptyMap(),
            settlements = emptyList(),
        )
    }
}
