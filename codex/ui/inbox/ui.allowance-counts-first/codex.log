/**
 * Receive allowance (screen 2): amount field, two suggestion chips, a per-denomination stepper list, a live sum
 * line (red while invalid) and "지갑에 넣기".
 */
@Composable
fun ReceiveAllowanceScreen(model: ReceiveAllowanceModel, onBack: () -> Unit, modifier: Modifier = Modifier) {
    val draft by model.draft.collectAsState()
    val submitting by model.submitting.collectAsState()
    val periodStart by model.periodStart.collectAsState()
    ReceiveAllowanceContent(
        draft = draft,
        periodStart = periodStart,
        submitting = submitting,
        onBack = onBack,
        onAmountChange = model::onAmountChange,
        onStyle = model::onStyle,
        onIncrement = model::increment,
        onDecrement = model::decrement,
        onSubmit = model::submit,
        modifier = modifier,
    )
}

/** Stateless body of [ReceiveAllowanceScreen]. */
@Composable
fun ReceiveAllowanceContent(
    draft: AllowanceDraft,
    periodStart: LocalDate,
    submitting: Boolean,
    onBack: () -> Unit,
    onAmountChange: (String) -> Unit,
    onStyle: (SplitStyle) -> Unit,
    onIncrement: (Denomination) -> Unit,
    onDecrement: (Denomination) -> Unit,
    onSubmit: () -> Unit,
    modifier: Modifier = Modifier,
) {
    Column(modifier.fillMaxSize()) {
        ScreenHeader(Strings.ALLOWANCE_TITLE, onBack = onBack)
        Column(
            Modifier.weight(1f).verticalScroll(rememberScrollState()).padding(horizontal = 20.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp),
        ) {
            OutlinedTextField(
                value = draft.digits,
                onValueChange = onAmountChange,
                label = { Text(Strings.ALLOWANCE_AMOUNT) },
                placeholder = { Text(Strings.ALLOWANCE_AMOUNT_HINT) },
                prefix = { Text("₩") },
                singleLine = true,
                isError = draft.amountNotCash,
                supportingText = if (draft.amountNotCash) ({ Text(Strings.AMOUNT_NOT_CASH) }) else null,
                visualTransformation = ThousandsSeparatorTransformation,
                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
                textStyle = MaterialTheme.typography.titleLarge.copy(fontWeight = FontWeight.SemiBold),
                modifier = Modifier.fillMaxWidth(),
            )
            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                StyleChip(Strings.STYLE_ATM, SplitStyle.LARGEST_FIRST, draft, onStyle)
                StyleChip(Strings.STYLE_BALANCED, SplitStyle.BALANCED, draft, onStyle)
            }
            SectionLabel(Strings.SPLIT_TITLE)
            Column {
                Denomination.descending.forEachIndexed { i, d ->
                    if (i > 0) HorizontalDivider(color = MaterialTheme.colorScheme.outlineVariant.copy(alpha = 0.5f))
                    DenominationStepperRow(d, draft.countOf(d), onIncrement, onDecrement)
                }
            }
            SumLine(draft)
            Text(
                Strings.periodStartNote(periodStart.shortLabel()),
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.onSurfaceVariant,
            )
            Spacer(Modifier.height(4.dp))
        }
        Button(
            onClick = onSubmit,
            enabled = draft.isValid && !submitting,
            modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 12.dp).height(52.dp),
        ) { Text(Strings.PUT_IN_WALLET, style = MaterialTheme.typography.titleMedium) }
    }
}

@Composable
private fun StyleChip(label: String, style: SplitStyle, draft: AllowanceDraft, onStyle: (SplitStyle) -> Unit) {
    FilterChip(
        selected = draft.style == style && !draft.edited && draft.counts.isNotEmpty(),
        onClick = { onStyle(style) },
        label = { Text(label) },
    )
}

@Composable
private fun SumLine(draft: AllowanceDraft) {
    val target = draft.amount ?: Won.ZERO
    val color = if (draft.showSumError) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary
    Column {
        Text(
            Strings.splitSum(draft.sum.formatted(), target.formatted()),
            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.Bold),
            color = color,
        )
        if (draft.showSumError && !draft.amountNotCash && draft.sum != target) {
            val diff = draft.sum - target
            Text(
                Strings.splitDiff(Won(abs(diff.value)).formatted(), over = diff.value > 0),
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.error,
            )
        }
    }
}
package com.jim.realcash.ui.allowance

import com.jim.realcash.domain.calc.SplitStyle
import com.jim.realcash.domain.model.Denomination.C100
import com.jim.realcash.domain.model.Denomination.W10000
import com.jim.realcash.domain.model.Denomination.W1000
import com.jim.realcash.domain.model.Denomination.W5000
import com.jim.realcash.domain.model.Denomination.W50000
import com.jim.realcash.domain.model.Won
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFalse
import kotlin.test.assertNull
import kotlin.test.assertTrue

class AllowanceDraftTest {
    @Test
    fun emptyDraftIsInvalid() {
        val d = AllowanceDraft()
        assertNull(d.amount)
        assertFalse(d.isValid)
        assertFalse(d.showSumError)
        assertEquals(Won.ZERO, d.sum)
    }

    @Test
    fun typingAnAmountSuggestsLargestFirst() {
        val d = AllowanceDraft().withAmountText("100,000")
        assertEquals("100000", d.digits)
        assertEquals(Won(100_000), d.amount)
        assertEquals(mapOf(W50000 to 2), d.counts)
        assertTrue(d.isValid)
        assertFalse(d.edited)
        assertEquals(Won(100_000), d.sum)
    }

    @Test
    fun balancedStyleKeepsMoreTenThousands() {
        val d = AllowanceDraft().withAmountText("100000").withStyle(SplitStyle.BALANCED)
        assertEquals(mapOf(W50000 to 1, W10000 to 5), d.counts)
        assertTrue(d.isValid)
        assertEquals(SplitStyle.BALANCED, d.style)
    }

    @Test
    fun steppersEditFreelyAndValidateAgainstTheAmount() {
        var d = AllowanceDraft().withAmountText("100000")
        d = d.increment(W1000)
        assertTrue(d.edited)
        assertFalse(d.isValid)
        assertTrue(d.showSumError)
        assertEquals(Won(101_000), d.sum)

        d = d.decrement(W50000)
        assertEquals(Won(51_000), d.sum)
        assertFalse(d.isValid)

        // Rebuild exactly 100,000 by hand: 50000 + 10000x4 + 5000 + 1000x4 + 1000 already there = 100,000.
        repeat(4) { d = d.increment(W10000) }
        d = d.increment(W5000)
        repeat(4) { d = d.increment(W1000) }
        assertEquals(Won(100_000), d.sum)
        assertTrue(d.isValid)
        assertFalse(d.showSumError)
        assertEquals(mapOf(W50000 to 1, W10000 to 4, W5000 to 1, W1000 to 5), d.split())
    }

    @Test
    fun decrementAtZeroIsANoOp() {
        val d = AllowanceDraft().withAmountText("1000")
        assertEquals(d, d.decrement(C100))
        assertEquals(0, d.countOf(C100))
    }

    @Test
    fun retypingTheAmountResetsEdits() {
        val d = AllowanceDraft().withAmountText("1000").increment(W1000).withAmountText("5000")
        assertFalse(d.edited)
        assertEquals(mapOf(W5000 to 1), d.counts)
    }

    @Test
    fun pickingAStyleAfterEditsResetsTheCounts() {
        val d = AllowanceDraft().withAmountText("60000").increment(C100).withStyle(SplitStyle.LARGEST_FIRST)
        assertFalse(d.edited)
        assertEquals(mapOf(W50000 to 1, W10000 to 1), d.counts)
    }

    @Test
    fun nonCashAmountsAreFlaggedAndGetNoSuggestion() {
        val d = AllowanceDraft().withAmountText("6505")
        assertTrue(d.amountNotCash)
        assertEquals(emptyMap(), d.counts)
        assertFalse(d.isValid)
        assertTrue(d.showSumError)
    }

    @Test
    fun zeroAmountIsInvalid() {
        val d = AllowanceDraft().withAmountText("0")
        assertEquals("", d.digits)
        assertFalse(d.isValid)
    }

    @Test
    fun splitDropsZeroCountsAndOrdersLargestFirst() {
        val d = AllowanceDraft().withAmountText("1000").increment(W50000).decrement(W1000).increment(C100).decrement(C100)
        assertEquals(listOf(W50000), d.split().keys.toList())
        assertEquals(mapOf(W50000 to 1), d.split())
    }
}

