/**
 * One denomination row with a miniature face, the subtotal and −/count/+ (allowance split, exchange "받을 돈").
 */
@Composable
fun DenominationStepperRow(
    d: Denomination,
    count: Int,
    onIncrement: (Denomination) -> Unit,
    onDecrement: (Denomination) -> Unit,
    modifier: Modifier = Modifier,
) {
    val art = LocalMoneyArt.current
    val faceLabel = "${d.faceLabel}원"
    Row(modifier.fillMaxWidth().padding(vertical = 6.dp), verticalAlignment = Alignment.CenterVertically) {
        if (d.kind == Denomination.Kind.BILL) {
            BillFace(d, Modifier.size(width = 52.dp, height = 52.dp / d.billAspectRatio), art.painter(d))
        } else {
            Row(Modifier.width(52.dp), horizontalArrangement = Arrangement.Center) {
                CoinFace(d, Modifier.size(24.dp), art.painter(d))
            }
        }
        Spacer(Modifier.width(12.dp))
        Column(Modifier.weight(1f)) {
            Text(faceLabel, style = MaterialTheme.typography.bodyLarge.copy(fontWeight = FontWeight.Medium))
            if (count > 0) {
                Text(
                    (d.amount * count).formatted(),
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
            }
        }
        FilledTonalIconButton(
            onClick = { onDecrement(d) },
            enabled = count > 0,
            modifier = Modifier.size(36.dp).semantics { contentDescription = "$faceLabel 빼기" },
        ) { Text("−", style = MaterialTheme.typography.titleMedium) }
        Text(
            count.toString(),
            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold),
            textAlign = TextAlign.Center,
            modifier = Modifier.widthIn(min = 40.dp),
        )
        FilledTonalIconButton(
            onClick = { onIncrement(d) },
            modifier = Modifier.size(36.dp).semantics { contentDescription = "$faceLabel 더하기" },
        ) { Text("+", style = MaterialTheme.typography.titleMedium) }
    }
}
package com.jim.realcash.domain.calc

import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.domain.model.Won
import com.jim.realcash.domain.model.total

/** Style of the default denomination split offered on the allowance screen. */
enum class SplitStyle {
    /** ATM style: as many large bills as possible (same as [ChangeCalculator.minimalChange]). */
    LARGEST_FIRST,

    /** More 10,000원 bills: at least 50,000원 (or the whole amount, if smaller) is kept out of 50,000원 bills. */
    BALANCED,
}

/** Suggests and validates how an allowance amount is split into denominations. */
object SplitSuggester {

    private const val BALANCED_RESERVE = 50_000

    /**
     * Default split of [amount] for the given [style]; the counts always sum to [amount].
     *
     * [SplitStyle.BALANCED]: `n50000 = max(0, (amount - 50,000) / 50,000)`, the rest is broken down greedily
     * without 50,000원 bills. E.g. 100,000원 -> 50,000×1 + 10,000×5.
     * Throws [IllegalArgumentException] if [amount] is negative or not a multiple of 10 won.
     */
    fun suggest(amount: Won, style: SplitStyle): Map<Denomination, Int> = when (style) {
        SplitStyle.LARGEST_FIRST -> ChangeCalculator.minimalChange(amount)
        SplitStyle.BALANCED -> {
            ChangeCalculator.minimalChange(amount) // validates the amount
            val fifties = maxOf(0, (amount.value - BALANCED_RESERVE) / Denomination.W50000.won)
            val rest = amount.value - fifties * Denomination.W50000.won
            val smaller = ChangeCalculator.greedy(rest, Denomination.descending - Denomination.W50000)
            if (fifties > 0) linkedMapOf(Denomination.W50000 to fifties) + smaller else smaller
        }
    }

    /** True when every count is non-negative and the split sums exactly to [amount]. */
    fun validate(amount: Won, split: Map<Denomination, Int>): Boolean =
        amount.value >= 0 && split.values.all { it >= 0 } && split.total() == amount
}
package com.jim.realcash.domain.model

import kotlin.jvm.JvmInline
import kotlinx.serialization.Serializable

/**
 * An amount of Korean won as an integer number of won.
 *
 * Non-negativity is not validated on construction; the domain operations guarantee it in their results.
 */
@Serializable
@JvmInline
value class Won(val value: Int) : Comparable<Won> {

    /** Sum of two amounts. */
    operator fun plus(other: Won): Won = Won(value + other.value)

    /** Difference of two amounts (may be negative; callers decide how to handle that). */
    operator fun minus(other: Won): Won = Won(value - other.value)

    /** This amount multiplied by [count]. */
    operator fun times(count: Int): Won = Won(value * count)

    /** Compares by numeric value. */
    override fun compareTo(other: Won): Int = value.compareTo(other.value)

    /** True when the amount can be represented with Korean cash (multiples of 10 won). */
    val isCashRepresentable: Boolean get() = value % CASH_UNIT == 0

    /**
     * The amount rounded **up** to the next multiple of 10 won, i.e. what has to leave the wallet in cash.
     * A 6,505원 card payment costs 6,510원 in cash because there is no 5원 coin.
     */
    fun roundUpToCash(): Won {
        val rem = value % CASH_UNIT
        return if (rem == 0) this else Won(value - rem + CASH_UNIT)
    }

    /** Human-readable form, e.g. `6,500원`. */
    override fun toString(): String = "${formatGrouped(value)}원"

    /** Constants for [Won]. */
    companion object {
        /** Zero won. */
        val ZERO: Won = Won(0)

        /** Smallest Korean cash denomination in won. */
        const val CASH_UNIT: Int = 10

        private fun formatGrouped(v: Int): String {
            val digits = kotlin.math.abs(v.toLong()).toString()
            val grouped = digits.reversed().chunked(3).joinToString(",").reversed()
            return if (v < 0) "-$grouped" else grouped
        }
    }
}

/** Sum of all amounts; [Won.ZERO] for an empty collection. */
fun Iterable<Won>.sum(): Won = fold(Won.ZERO) { acc, w -> acc + w }
package com.jim.realcash.domain.model

import kotlinx.serialization.Serializable

/** The eight Korean cash denominations, from the 50,000원 bill down to the 10원 coin. */
@Serializable
enum class Denomination(
    /** Face value in won. */
    val won: Int,
    /** Whether this denomination is a bill or a coin. */
    val kind: Kind,
) {
    /** 50,000원 bill. */
    W50000(50_000, Kind.BILL),

    /** 10,000원 bill. */
    W10000(10_000, Kind.BILL),

    /** 5,000원 bill. */
    W5000(5_000, Kind.BILL),

    /** 1,000원 bill. */
    W1000(1_000, Kind.BILL),

    /** 500원 coin. */
    C500(500, Kind.COIN),

    /** 100원 coin. */
    C100(100, Kind.COIN),

    /** 50원 coin. */
    C50(50, Kind.COIN),

    /** 10원 coin. */
    C10(10, Kind.COIN),
    ;

    /** Face value as [Won]. */
    val amount: Won get() = Won(won)

    /** Physical kind of a denomination. */
    enum class Kind {
        /** Paper bill. */
        BILL,

        /** Metal coin. */
        COIN,
    }

    /** Lookup helpers. */
    companion object {
        /** All denominations ordered from largest to smallest face value. */
        val descending: List<Denomination> = entries.sortedByDescending { it.won }

        /** All denominations ordered from smallest to largest face value. */
        val ascending: List<Denomination> = descending.reversed()

        /** The denomination whose face value is exactly [won], or `null` if there is none. */
        fun of(won: Int): Denomination? = entries.firstOrNull { it.won == won }
    }
}

/** Total value of a denomination-to-count map. */
fun Map<Denomination, Int>.total(): Won = Won(entries.sumOf { (d, n) -> d.won * n })
