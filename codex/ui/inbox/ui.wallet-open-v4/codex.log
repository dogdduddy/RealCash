@OptIn(ExperimentalCoroutinesApi::class)
class WalletOpenV3Test {
    @Test
    fun rightFloorScatterFitsBesideTheWholeWalletInBothOrientations() {
        for ((width, height) in listOf(320f to 568f, 390f to 844f, 844f to 390f)) {
            val layout = WalletOpenLayout.calculate(width, height)
            val coins = CoinScatter.place(7, listOf(34f, 34f, 28f, 24f), layout.coins)
            assertEquals(4, coins.size)
            assertTrue(layout.wallet.left >= 0f && layout.wallet.right <= width)
            assertTrue(layout.wallet.top >= 0f && layout.wallet.bottom <= height)
            coins.forEachIndexed { index, coin ->
                assertTrue(coin.x - coin.diameter / 2f > layout.wallet.right)
                assertTrue(coin.x + coin.diameter / 2f <= width)
                assertTrue(coin.y - coin.diameter / 2f >= layout.coins.top)
                assertTrue(coin.y + coin.diameter / 2f <= height)
                coins.take(index).forEach { other ->
                    assertTrue(kotlin.math.hypot(coin.x - other.x, coin.y - other.y) >= (coin.diameter + other.diameter) / 2f)
                }
            }
        }
    }

    @Test
    fun onlyExposedPaperInsideTheLensCanBePicked() {
        val layout = WalletOpenLayout.calculate(390f, 844f)
        val groups = pocketBillGroups(mapOf(W50000 to 1, W10000 to 3, W5000 to 2, W1000 to 5), layout.pocket)
        groups.forEachIndexed { index, group ->
            val unit = CashUnit(
                CashUnitId("hit-$index"), group.denomination,
                CashUnitState.IN_WALLET, Instant.parse("2026-11-05T09:00:00Z"),
                CashUnitSource.ALLOWANCE,
            )
            val hit = CashHit(unit, false, pocketBillHitBounds(groups, index),
                WalletRect(group.frontLeft, group.top, group.billWidth, group.billHeight), layout.wallet)
            assertTrue(hit.contains(hit.hit.center))
            assertFalse(hit.contains(Offset(group.right + 1f, hit.hit.center.y)), "the group gap is not paper")
            assertFalse(hit.contains(Offset(group.left + 1f, layout.wallet.top)), "the lens tips and walls are not paper")
        }
        val first = groups.first()
        val outsideLens = Offset(first.left + 1f, first.top + 1f)
        assertTrue(pocketBillHitBounds(groups, 0).contains(outsideLens))
        assertFalse(WalletOpening.contains(layout.wallet, outsideLens), "clipped paper corners must reject pickup")
    }

    @Test
    fun floorDropsExcludeArtEdgesAndOtherCoins() {
        val layout = WalletOpenLayout.calculate(390f, 844f)
        val floor = WalletRect(0f, 56f, 390f, 788f)
        val left = Offset(40f, 600f)
        val target = assertNotNull(floorCoinTarget(left, 34f, floor, layout.wallet, layout.tray, emptyList()))
        assertEquals(left, target.center)
        assertNull(floorCoinTarget(layout.wallet.center, 34f, floor, layout.wallet, layout.tray, emptyList()))
        assertNull(floorCoinTarget(layout.tray.center, 34f, floor, layout.wallet, layout.tray, emptyList()))
        assertNull(floorCoinTarget(Offset(2f, 600f), 34f, floor, layout.wallet, layout.tray, emptyList()))
        assertNull(floorCoinTarget(left + Offset(30f, 0f), 34f, floor, layout.wallet, layout.tray, listOf(target)))
    }

    @Test
    fun v3ScreenshotsAndCoinLeftPositionSurviveRecompositionAndTraySave() = runTest {
        val driver = DriverFactory().createDriver()
        val clock = object : Clock { override fun now() = Instant.parse("2026-11-05T09:00:00Z") }
        try {
            val data = RealCashData(driver, clock, SequentialIdGenerator(), kotlin.coroutines.EmptyCoroutineContext)
            val counts = mapOf(W50000 to 1, W10000 to 3, W5000 to 2, W1000 to 5, C500 to 2)
            data.wallet.receiveAllowance(counts, LocalDate(2026, 11, 1))
            val model = WalletOpenModel(backgroundScope, AppEnvironment(data, Haptics.None, clock = clock), seed = 7)
            val scene = ImageComposeScene(390, 844, Density(1f), coroutineContext = coroutineContext) {
                RealCashTheme(darkTheme = false) {
                    CompositionLocalProvider(LocalMoneyArt provides ResourceMoneyArt) {
                        Surface { WalletOpenScreen(model, {}, {}) }
                    }
                }
            }
            var time = 0L
            fun frame() { Snapshot.sendApplyNotifications(); scene.render(time); time += 16_000_000L }
            fun settle() { repeat(100) { frame(); runCurrent() } }
            fun pointer(type: PointerEventType, point: Offset) = scene.sendPointerEvent(type, point, timeMillis = testScheduler.currentTime)
            fun screenshot(name: String) {
                val dir = File(System.getProperty("realcash.screenshotDir") ?: "build/screenshots").apply { mkdirs() }
                File(dir, name).writeBytes(checkNotNull(scene.render(time).encodeToData(EncodedImageFormat.PNG)).bytes)
            }
            fun pick(point: Offset) {
                pointer(PointerEventType.Press, point)
                advanceTimeBy(400); runCurrent(); frame()
                assertNotNull(model.physics.picked)
            }
            fun drop(point: Offset) {
                pointer(PointerEventType.Move, point)
                pointer(PointerEventType.Release, point)
                runCurrent(); frame()
            }
            try {
                settle()
                screenshot("v3b-open.png")
                val layout = WalletOpenLayout.calculate(390f, 844f)
                val groups = pocketBillGroups(counts, layout.pocket)
                val front = model.ui.value.inWallet.first { it.denomination == W10000 }
                // Even the far right back edge picks the left front unit from the whole group hit band.
                val billPoint = Offset(groups[1].right - 0.5f, pocketBillHitBounds(groups, 1).center.y)
                pick(billPoint)
                val picked = assertNotNull(model.physics.picked)
                assertEquals(front.id, picked.unit.id)
                assertEquals(groups[1].left, picked.source.left)
                assertEquals(3, model.ui.value.inWallet.count { it.denomination == W10000 }, "holding preserves the original fan slots")
                pointer(PointerEventType.Move, Offset(190f, 300f))
                settle()
                screenshot("v3b-held.png")
                drop(layout.wallet.center)
                assertEquals(picked.source, model.physics.flight?.target, "return to the left front slot")
                settle()
                val coinPosition = CoinScatter.place(7, listOf(34f, 34f), layout.coins).first()
                val coinSource = Offset(coinPosition.x, coinPosition.y)
                pick(coinSource)
                val coinId = assertNotNull(model.physics.picked).unit.id
                val left = Offset(40f, 600f)
                drop(left)
                assertEquals(left, model.physics.flight?.target?.center)
                settle()
                assertFalse(model.ui.value.changed, "moving on the floor does not change ownership")
                screenshot("v3-coin-left.png")

                // Saving another bill reflows/recomposes the UI without resetting the floor coin.
                model.setOnTray(model.ui.value.inWallet.first { it.denomination == W5000 }.id, true)
                advanceTimeBy(300); runCurrent(); settle()
                assertEquals(1, data.wallet.state.value.inHand.size)
                pick(left)
                assertEquals(coinId, model.physics.picked?.unit?.id)
                drop(layout.wallet.center)
                assertEquals(left, model.physics.flight?.target?.center, "wallet art springs the coin back to its left floor source")
                settle()
                pick(left)
                assertEquals(coinId, model.physics.picked?.unit?.id)
                drop(layout.trayInner.center)
                advanceTimeBy(300); runCurrent(); settle()
                assertTrue(data.wallet.state.value.inHand.any { it.id == coinId })
                // Tray coins may also return directly to the left floor, using the normal debounce.
                val trayPoint = traySlots(model.ui.value.inHand, layout.trayInner, mapOf(coinId to layout.trayInner.center)).getValue(coinId).center
                pick(trayPoint)
                assertEquals(coinId, model.physics.picked?.unit?.id)
                drop(left)
                advanceTimeBy(300); runCurrent(); settle()
                assertTrue(data.wallet.state.value.inWallet.any { it.id == coinId })
                pick(left)
                assertEquals(coinId, model.physics.picked?.unit?.id)
                pointer(PointerEventType.Release, left)
            } finally { scene.close() }
        } finally { driver.close() }
    }
}
package com.jim.realcash.ui.walletopen

import androidx.compose.runtime.snapshots.Snapshot
import androidx.compose.runtime.snapshots.SnapshotStateObserver
import androidx.compose.ui.geometry.Offset
import com.jim.realcash.domain.model.*
import kotlin.test.*
import kotlin.time.Instant

class WalletPhysicsTest {
    private val bill = CashUnit(CashUnitId("front"), Denomination.W10000, CashUnitState.IN_WALLET,
        Instant.parse("2026-11-04T09:00:00Z"), CashUnitSource.ALLOWANCE)
    private val tray = WalletRect(10f, 10f, 200f, 100f)
    private val wallet = WalletRect(20f, 300f, 220f, 400f)
    private val source = WalletRect(40f, 340f, 60f, 140f)

    @Test fun fingerFollowsTheLeadingEdgeAndReleasesOnlyBeyondClearance() {
        val strip = WalletRect(40f, 100f, 20f, 30f)
        assertEquals(SwayContact(SwayState.Rest, false), SwayState.contact(50f, 1, strip, 8f))
        assertEquals(SwayContact(SwayState(4f), false), SwayState.contact(64f, 1, strip, 8f))
        assertEquals(SwayContact(SwayState(7f), false), SwayState.contact(67f, 1, strip, 8f))
        assertEquals(SwayContact(SwayState(7f), true), SwayState.contact(68f, 1, strip, 8f))
        assertEquals(SwayContact(SwayState(-4f), false), SwayState.contact(36f, -1, strip, 8f))
        assertEquals(SwayContact(SwayState(-7f), true), SwayState.contact(32f, -1, strip, 8f))
        assertEquals(SwayContact(SwayState(10f), true), SwayState.contact(100f, 1, strip, 40f))
        assertEquals(SwayContact(SwayState.Rest, true), SwayState.contact(61f, 1, strip, 0.5f))
        assertEquals(0f, SwayState.limit(1f))
        assertEquals(10f, SwayState.limit(100f))
        assertEquals(0.35f, SwayState.DAMPING)
        assertEquals(420f, SwayState.STIFFNESS)
    }

    @Test fun displacementTiltsAroundXWithTwelveDegreeLimit() {
        assertEquals(60f, SwayState.rotationX(0f))
        assertEquals(54f, SwayState.rotationX(5f))
        assertEquals(66f, SwayState.rotationX(-5f))
        assertEquals(48f, SwayState.rotationX(10f))
        assertEquals(72f, SwayState.rotationX(-10f))
        assertEquals(48f, SwayState.rotationX(100f))
        assertEquals(72f, SwayState.rotationX(-100f))
    }

    @Test fun onlyTwoNeighborsReceiveHalfAndQuarterWithStagger() {
        assertEquals(listOf(SwayPulse(3, SwayState(4f), 20), SwayPulse(4, SwayState(2f), 40)),
            SwayState.neighbors(2, 1, 6, 8f))
        assertEquals(listOf(SwayPulse(1, SwayState(-4f), 20), SwayPulse(0, SwayState(-2f), 40)),
            SwayState.neighbors(2, -1, 6, -8f))
        assertEquals(listOf(SwayPulse(5, SwayState(4f), 20)), SwayState.neighbors(4, 1, 6, 8f))
        assertTrue(SwayState.neighbors(5, 1, 6, 8f).isEmpty())
        assertTrue(SwayState.neighbors(0, -1, 6, -8f).isEmpty())
    }

    @Test fun fastSwipeCrossesNarrowStripsButNotLeather() {
        val strip = WalletRect(40f, 100f, 3f, 30f)
        assertTrue(SwayState.crosses(Offset(0f, 110f), Offset(100f, 110f), strip))
        assertTrue(SwayState.crosses(Offset(100f, 110f), Offset(0f, 110f), strip))
        assertFalse(SwayState.crosses(Offset(0f, 150f), Offset(100f, 150f), strip))
        assertFalse(SwayState.crosses(Offset(0f, 110f), Offset(0f, 120f), strip))
    }

    @Test fun dropUsesTrayFloorAndOnlyTrayUnitsMayReturnToWallet() {
        val pick = PickState(bill, false, source, source.center)
        assertEquals(DropDestination.TRAY, pick.destination(tray.center, tray, wallet))
        assertEquals(DropDestination.SOURCE, pick.destination(wallet.center, tray, wallet))
        assertEquals(DropDestination.SOURCE, pick.destination(Offset(9f, 50f), tray, wallet))
        assertEquals(DropDestination.SOURCE, pick.destination(tray.center, tray, wallet, cancelled = true))
        assertEquals(DropDestination.WALLET, pick.copy(fromTray = true).destination(wallet.center, tray, wallet))
        assertEquals(90f, pick.rotation)
        assertEquals(DropFlight(tray, 0f, false), pick.flight(DropDestination.TRAY, tray))
        assertEquals(DropFlight(source, 90f, true), pick.flight(DropDestination.SOURCE, source))
        assertEquals(DropFlight(source, 90f, true), pick.copy(fromTray = true).flight(DropDestination.WALLET, source))
        assertEquals(source.height, pick.faceWidth)
        assertEquals(Offset(80f, 200f), pick.centerAt(Offset(80f, 200f)))
        assertEquals(400L, PickState.LONG_PRESS_MILLIS)
        assertEquals(300L, PickState.RETURN_MILLIS)
        assertEquals(1.08f, PickState.LIFT_SCALE)
    }

    @Test fun coinsKeepExactDropCenterAndCrowdedBillsStayInsideTray() {
        val coin = bill.copy(id = CashUnitId("coin"), denomination = Denomination.C500)
        val point = Offset(130f, 70f)
        assertEquals(point, traySlots(listOf(coin), tray, mapOf(coin.id to point)).getValue(coin.id).center)
        val many = List(30) { bill.copy(id = CashUnitId("bill-$it")) }
        val bounds = traySlots(many, tray, emptyMap()).values
        assertTrue(bounds.all { it.left >= tray.left && it.right <= tray.right + 0.001f })
    }

    @Test fun pointerMovesInvalidateOnlyLayerUntilTrayEdgeChanges() {
        val physics = WalletOpenPhysics().apply { this.tray = this@WalletPhysicsTest.tray }
        physics.start(PickState(bill, false, source, source.center))
        Snapshot.sendApplyNotifications()
        var invalidations = 0
        val observer = SnapshotStateObserver { it() }
        observer.start()
        try {
            observer.observeReads("composition", { _: String -> invalidations++ }) {
                physics.picked?.unit?.id
                physics.overTray
            }
            repeat(30) { physics.move(source.center + Offset(it.toFloat(), 0f)); Snapshot.sendApplyNotifications() }
            assertEquals(0, invalidations, "in-pocket movement must not recompose any bill")
            physics.move(tray.center)
            Snapshot.sendApplyNotifications()
            assertEquals(1, invalidations, "only crossing the tray boundary invalidates composition")
        } finally { observer.stop(); observer.clear() }
    }
}

