            assertEquals(group.billHeight, group.face.height)
        }
    }

    @Test fun swipeRegionsContainOnlyUnoccludedPaperToTheRightOfOpening() {
        val groups = pocketBillGroups(allowance, WalletOpenLayout.calculate(390f, 844f).pocket)
