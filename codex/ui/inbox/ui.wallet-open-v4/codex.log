import kotlin.test.*

class WalletOpenLayoutTest {
    private val allowance = mapOf(W50000 to 1, W10000 to 3, W5000 to 2, W1000 to 5)

    @Test fun expensiveDenominationsPaintUnderCheaperOnesAndBacksPaintFirst() {
