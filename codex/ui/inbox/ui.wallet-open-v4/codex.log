package com.jim.realcash.domain.model

import kotlinx.serialization.Serializable

/** The eight Korean cash denominations, from the 50,000원 bill down to the 10원 coin. */
@Serializable
enum class Denomination(
    /** Face value in won. */
    val won: Int,
    /** Whether this denomination is a bill or a coin. */
    val kind: Kind,
) {
    /** 50,000원 bill. */
    W50000(50_000, Kind.BILL),

    /** 10,000원 bill. */
    W10000(10_000, Kind.BILL),

    /** 5,000원 bill. */
    W5000(5_000, Kind.BILL),

    /** 1,000원 bill. */
    W1000(1_000, Kind.BILL),

    /** 500원 coin. */
    C500(500, Kind.COIN),

    /** 100원 coin. */
    C100(100, Kind.COIN),

    /** 50원 coin. */
    C50(50, Kind.COIN),

    /** 10원 coin. */
    C10(10, Kind.COIN),
    ;

    /** Face value as [Won]. */
    val amount: Won get() = Won(won)

    /** Physical kind of a denomination. */
    enum class Kind {
        /** Paper bill. */
        BILL,

        /** Metal coin. */
        COIN,
    }

    /** Lookup helpers. */
    companion object {
        /** All denominations ordered from largest to smallest face value. */
        val descending: List<Denomination> = entries.sortedByDescending { it.won }

        /** All denominations ordered from smallest to largest face value. */
        val ascending: List<Denomination> = descending.reversed()

        /** The denomination whose face value is exactly [won], or `null` if there is none. */
        fun of(won: Int): Denomination? = entries.firstOrNull { it.won == won }
    }
}

/** Total value of a denomination-to-count map. */
fun Map<Denomination, Int>.total(): Won = Won(entries.sumOf { (d, n) -> d.won * n })
package com.jim.realcash.domain.model

import kotlin.time.Instant
import kotlinx.serialization.Serializable

/** Lifecycle state of a [CashUnit]. A unit is in exactly one state at a time. */
@Serializable
enum class CashUnitState {
    /** Sitting in the wallet. */
    IN_WALLET,

    /** Taken out into the active [Hand]. */
    IN_HAND,

    /** Handed over in a settled payment. */
    SPENT,

    /** Given away in a user-initiated exchange (e.g. one 50,000원 bill for five 10,000원 bills). */
    EXCHANGED_AWAY,
}

/** How a [CashUnit] came into the wallet. */
@Serializable
enum class CashUnitSource {
    /** Part of a periodic allowance. */
    ALLOWANCE,

    /** Change returned after a payment. */
    CHANGE,

    /** Received in an exchange. */
    EXCHANGE,

    /** Added by a manual correction. */
    ADJUSTMENT,

    /** Returned by a refunded payment. */
    REFUND,
}

/** One bill or one coin. Units are individual objects and are never re-organised automatically. */
@Serializable
data class CashUnit(
    /** Stable identity of this unit. */
    val id: CashUnitId,
    /** Face value. */
    val denomination: Denomination,
    /** Current lifecycle state. */
    val state: CashUnitState,
    /** When the unit entered the wallet. */
    val acquiredAt: Instant,
    /** How the unit entered the wallet. */
    val source: CashUnitSource,
) {
    /** Face value as [Won]. */
    val amount: Won get() = denomination.amount
}

/** Total face value of the given units. */
fun Iterable<CashUnit>.total(): Won = Won(sumOf { it.denomination.won })

/** Number of units per denomination, largest denomination first, zero counts omitted. */
fun Iterable<CashUnit>.countsByDenomination(): Map<Denomination, Int> {
    val counts = groupingBy { it.denomination }.eachCount()
    return Denomination.descending.filter { it in counts }.associateWith { counts.getValue(it) }
}
