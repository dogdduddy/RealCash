package com.jim.realcash.ui.money

import androidx.compose.runtime.Composable
import androidx.compose.runtime.staticCompositionLocalOf
import androidx.compose.ui.graphics.painter.Painter
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.ui.resources.Res
import com.jim.realcash.ui.resources.bill_w50000
import com.jim.realcash.ui.resources.bill_w10000
import com.jim.realcash.ui.resources.bill_w5000
import com.jim.realcash.ui.resources.bill_w1000
import com.jim.realcash.ui.resources.coin_c500
import com.jim.realcash.ui.resources.coin_c100
import com.jim.realcash.ui.resources.coin_c50
import com.jim.realcash.ui.resources.coin_c10
import org.jetbrains.compose.resources.painterResource

/**
 * Source of denomination artwork. [MoneyArt.None] keeps previews without artwork on Canvas placeholders.
 */
interface MoneyArt {
    /** Artwork for [denomination], or `null` for the placeholder. */
    @Composable
    fun painter(denomination: Denomination): Painter?

    /** No artwork: Canvas placeholders everywhere. */
    object None : MoneyArt {
        @Composable
        override fun painter(denomination: Denomination): Painter? = null
    }
}

/** Reviewed bill and coin artwork bundled by Compose resources on Android, iOS and desktop. */
object ResourceMoneyArt : MoneyArt {
    @Composable
    override fun painter(denomination: Denomination): Painter? = when (denomination) {
        Denomination.W50000 -> painterResource(Res.drawable.bill_w50000)
        Denomination.W10000 -> painterResource(Res.drawable.bill_w10000)
        Denomination.W5000 -> painterResource(Res.drawable.bill_w5000)
        Denomination.W1000 -> painterResource(Res.drawable.bill_w1000)
        Denomination.C500 -> painterResource(Res.drawable.coin_c500)
        Denomination.C100 -> painterResource(Res.drawable.coin_c100)
        Denomination.C50 -> painterResource(Res.drawable.coin_c50)
        Denomination.C10 -> painterResource(Res.drawable.coin_c10)
    }
}

/** The [MoneyArt] used by the screens; standalone previews retain the Canvas fallback. */
val LocalMoneyArt = staticCompositionLocalOf<MoneyArt> { MoneyArt.None }
 * The face of a coin (circle). The caller decides the size.
 *
 * @param painter artwork from the image pipeline; when `null`, a metallic radial gradient with a rim and the numeral.
 */
@Composable
fun CoinFace(denomination: Denomination, modifier: Modifier = Modifier, painter: Painter? = null) {
    val c = denomination.colors()
    val label = "${denomination.faceLabel}원"
    BoxWithConstraints(
        modifier = modifier
            .shadow(4.dp, CircleShape)
            .clip(CircleShape)
            .semantics { contentDescription = label },
        contentAlignment = Alignment.Center,
    ) {
        if (painter != null) {
            Image(
                painter,
                contentDescription = null,
                contentScale = ContentScale.Fit,
                alpha = if (MaterialTheme.colorScheme.background.luminance() < 0.5f) 0.92f else 1f,
                modifier = Modifier.fillMaxSize(),
            )
        } else {
            val d = minOf(maxWidth, maxHeight)
            Canvas(Modifier.fillMaxSize()) {
                val radius = size.minDimension / 2f
                drawCircle(
                    Brush.radialGradient(listOf(c.light, c.dark), center = Offset(radius * 0.7f, radius * 0.6f), radius = radius * 1.5f),
                    radius = radius,
                )
                drawCircle(c.ink.copy(alpha = 0.25f), radius = radius * 0.82f, style = Stroke(width = radius * 0.06f))
            }
            Text(
                denomination.faceLabel,
                style = MaterialTheme.typography.labelSmall.copy(
                    fontWeight = FontWeight.Bold,
                    fontSize = with(androidx.compose.ui.platform.LocalDensity.current) { (d * 0.30f).toSp() },
                ),
                color = c.ink,
                maxLines = 1,
            )
        }
    }
}

/** Offset of one back layer in a stack. */
private val LayerStep = 3.dp

/** Maximum number of back layers drawn behind the front face. */
private const val MAX_BACK_LAYERS = 3

/**
 * A stack of [count] bills of one denomination: the front face plus up to three offset back layers
 * (HardPay's `backLayers` idea) and a count badge. Fills the available width scaled by [Denomination.relativeSize].
 *
 * The stack always reserves room for the maximum offset so that stacks of different counts line up.
 *
 * @param painter pipeline artwork passed to every [BillFace] of the stack.
 * @param onClick tap action (T5b: take one bill out); `null` = not clickable.
 */
@Composable
fun BillStack(
    denomination: Denomination,
    count: Int,
    modifier: Modifier = Modifier,
    painter: Painter? = null,
    onClick: (() -> Unit)? = null,
) {
    val backLayers = (count - 1).coerceIn(0, MAX_BACK_LAYERS)
    val reserve = LayerStep * MAX_BACK_LAYERS
    Box(modifier.padding(end = reserve, bottom = reserve, top = 6.dp)) {
        val faceModifier = Modifier.fillMaxWidth(denomination.relativeSize).aspectRatio(denomination.billAspectRatio)
        repeat(backLayers) { i ->
            val depth = backLayers - i
            BillFace(
                denomination,
                faceModifier.offset(x = LayerStep * depth, y = LayerStep * depth).alpha(0.75f),
                painter,
            )
        }
        BillFace(
            denomination,
            if (onClick != null) faceModifier.clickable(onClick = onClick) else faceModifier,
            painter,
        )
        CountBadge(count, Modifier.align(Alignment.TopEnd).offset(x = reserve - 2.dp, y = (-6).dp))
    }
}

/**
 * A stack of [count] coins of one denomination: the front coin plus up to three darker back layers below it,
 * and a count badge.
 *
 * @param size diameter of the largest coin (500원); smaller coins scale by [Denomination.relativeSize].
 */
@Composable
fun CoinStack(
    denomination: Denomination,
    count: Int,
    modifier: Modifier = Modifier,
    size: Dp = 46.dp,
    painter: Painter? = null,
    onClick: (() -> Unit)? = null,
) {
    val backLayers = (count - 1).coerceIn(0, MAX_BACK_LAYERS)
    val reserve = LayerStep * MAX_BACK_LAYERS
    val d = size * denomination.relativeSize
    Box(modifier.size(width = size + 10.dp, height = size + reserve + 6.dp), contentAlignment = Alignment.BottomCenter) {
        repeat(backLayers) { i ->
            val depth = backLayers - i
            CoinFace(
                denomination,
                Modifier.size(d).offset(y = -reserve + LayerStep * depth).drawWithContent {
                    drawContent()
                    drawCircle(Color.Black.copy(alpha = 0.18f), radius = this.size.minDimension / 2f)
                },
                painter,
            )
        }
        val front = Modifier.size(d).offset(y = -reserve)
        CoinFace(denomination, if (onClick != null) front.clickable(onClick = onClick) else front, painter)
        CountBadge(count, Modifier.align(Alignment.TopEnd))
    }
}

/** Small pill showing `×N`. Hidden for N <= 1. */
@Composable
fun CountBadge(count: Int, modifier: Modifier = Modifier) {
    if (count <= 1) return
    Text(
        "×$count",
        style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),
        color = MaterialTheme.colorScheme.onSecondaryContainer,
        modifier = modifier
            .background(MaterialTheme.colorScheme.secondaryContainer, RoundedCornerShape(50))
package com.jim.realcash.ui.money

import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.width
import androidx.compose.ui.ImageComposeScene
