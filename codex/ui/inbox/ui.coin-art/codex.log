package com.jim.realcash.ui.money

import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.width
import androidx.compose.ui.ImageComposeScene
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.ui.theme.RealCashTheme
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertNotNull
import kotlin.test.assertNull

class ResourceMoneyArtTest {
    @Test
    fun reviewedBillsLoadSynchronouslyAndCoinsKeepCanvasFallback() {
        // Each reviewed image has a distinct height, so this also catches swapped denominations / the unused draft.
        val expectedHeights = mapOf(
            Denomination.W50000 to 452f,
            Denomination.W10000 to 470f,
            Denomination.W5000 to 490f,
            Denomination.W1000 to 512f,
        )
        val loaded = mutableSetOf<Denomination>()
        val scene = ImageComposeScene(360, 600) {
            RealCashTheme {
                Column {
                    Denomination.entries.forEach { denomination ->
                        val painter = ResourceMoneyArt.painter(denomination)
                        assertNull(MoneyArt.None.painter(denomination))
                        val height = expectedHeights[denomination]
                        if (height == null) {
                            assertNull(painter, "coins must retain their Canvas face")
                        } else {
                            assertNotNull(painter, "missing reviewed artwork for $denomination")
                            assertEquals(1024f, painter.intrinsicSize.width)
                            assertEquals(height, painter.intrinsicSize.height)
                            BillStack(denomination, 3, Modifier.width(300.dp), painter)
                            loaded += denomination
                        }
                    }
                }
            }
        }
        try {
            scene.render()
            assertEquals(expectedHeights.keys, loaded)
        } finally {
            scene.close()
        }
    }
}
import org.jetbrains.kotlin.gradle.dsl.JvmTarget

// Compose Multiplatform app shell and screens on top of :shared:data.
// Targets: Android (hosted by :androidApp), desktop JVM (verification on this host: compile, unit tests,
// offscreen screenshots) and iOS.
plugins {
    alias(libs.plugins.kotlin.multiplatform)
    alias(libs.plugins.compose.multiplatform)
    alias(libs.plugins.compose.compiler)
    alias(libs.plugins.android.library)
}

kotlin {
    androidTarget {
        compilerOptions {
            jvmTarget.set(JvmTarget.JVM_17)
        }
    }
    jvm {
        compilerOptions {
            jvmTarget.set(JvmTarget.JVM_17)
        }
    }
    iosArm64()
    iosSimulatorArm64()

    compilerOptions {
        optIn.add("kotlin.time.ExperimentalTime")
    }

    sourceSets {
        commonMain.dependencies {
            api(project(":shared:data"))
            implementation(libs.compose.runtime)
            implementation(libs.compose.foundation)
            implementation(libs.compose.ui)
            implementation(libs.compose.material3)
            // NOTE(T3): RealCashRoot maps the platform back event (Android back button / gesture) to the back stack.
            implementation(libs.compose.ui.backhandler)
            // Reviewed money artwork (assets/img/drawable) is exposed as Res.drawable.* on every platform.
            implementation(compose.components.resources)
        }
        jvmMain.dependencies {
            // Skiko runtime + desktop window APIs for the host OS.
            implementation(compose.desktop.currentOs)
            // Dispatchers.Main (AWT event thread) for the desktop window and lifecycle code.
            implementation(libs.kotlinx.coroutines.swing)
        }
        jvmTest.dependencies {
            implementation(libs.kotlin.test)
            implementation(libs.kotlinx.coroutines.test)
        }
    }
}

// Android library side of the KMP module (classic com.android.library + androidTarget()).
android {
    namespace = "com.jim.realcash.ui"
    compileSdk = libs.versions.android.compileSdk.get().toInt()
    buildToolsVersion = libs.versions.android.buildTools.get()
    defaultConfig {
        minSdk = libs.versions.android.minSdk.get().toInt()
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
}

// The reviewed assets live in assets/img (manifest, LOG.md); they are served as Compose resources from there
// instead of being copied into src/commonMain/composeResources, so the repo keeps one copy per image.
compose.resources {
    publicResClass = false
    packageOfResClass = "com.jim.realcash.ui.resources"
    customDirectory(
        sourceSetName = "commonMain",
        directoryProvider = provider { layout.projectDirectory.dir("../../assets/img") },
    )
}

compose.desktop {
    application {
        mainClass = "com.jim.realcash.ui.DesktopMainKt"
    }
}

// Offscreen screenshot rendering needs no display; keep AWT headless and let Skiko fall back to software.
tasks.withType<Test>().configureEach {
    systemProperty("java.awt.headless", "true")
    systemProperty("skiko.renderApi", "SOFTWARE")
    systemProperty("realcash.screenshotDir", layout.buildDirectory.dir("screenshots").get().asFile.absolutePath)
}

