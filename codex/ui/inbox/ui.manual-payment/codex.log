+        _submitting.value = true
+        scope.launch {
+            try {
+                val policy = data.settings.load().pullPolicy
+                val p = payment ?: DetectedPayment(
+                    id = PaymentId(data.ids.next()),
+                    amount = checkNotNull(draft.amount),
