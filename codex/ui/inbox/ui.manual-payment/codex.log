diff --git a/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraft.kt b/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraft.kt
