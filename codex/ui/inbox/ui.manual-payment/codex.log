diff --git a/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraft.kt b/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraft.kt
new file mode 100644
index 0000000000000000000000000000000000000000..735b08c3ee7892bdccacea6461fb8261c68daf25
--- /dev/null
+++ b/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraft.kt
@@ -0,0 +1,30 @@
+package com.jim.realcash.ui.manual
+
+import com.jim.realcash.domain.model.Denomination
+import com.jim.realcash.domain.model.Settlement
+import com.jim.realcash.domain.model.Won
+import com.jim.realcash.domain.model.total
+import com.jim.realcash.ui.format.AmountInput
+
+/** Immutable input and outcome of a manually entered payment; no repository or Compose state. */
+data class ManualPaymentDraft(
+    val digits: String = "",
+    val merchant: String = "",
+    val result: ManualPaymentResult? = null,
+) {
+    val amount: Won? get() = AmountInput.parse(digits)
+    val amountNotCash: Boolean get() = amount?.isCashRepresentable == false
+    val isValid: Boolean get() = amount?.let { it > Won.ZERO && it.isCashRepresentable } == true && result == null
+    val merchantOrNull: String? get() = merchant.trim().takeIf { it.isNotEmpty() }
+
+    fun withAmountText(text: String): ManualPaymentDraft = copy(digits = AmountInput.sanitize(text))
+}
+
+/** Display values from the actual repository settlement (no settlement calculation in the UI). */
+data class ManualPaymentResult(
+    val settlement: Settlement,
+    val paid: Won,
+) {
+    val change: Won get() = settlement.changeUnits.total()
+    val changeCounts: Map<Denomination, Int> get() = settlement.changeUnits.groupingBy { it.denomination }.eachCount()
+}
diff --git a/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentModel.kt b/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentModel.kt
new file mode 100644
index 0000000000000000000000000000000000000000..3bac2680761685d32ce7ff27593eac7159641ba5
--- /dev/null
+++ b/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentModel.kt
@@ -0,0 +1,80 @@
+package com.jim.realcash.ui.manual
+
+import com.jim.realcash.domain.model.DetectedPayment
+import com.jim.realcash.domain.model.PaymentId
+import com.jim.realcash.domain.model.total
+import com.jim.realcash.ui.AppEnvironment
+import com.jim.realcash.ui.Strings
+import kotlin.coroutines.cancellation.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/** Records a manual detection, then delegates all cash selection and settlement to the repository. */
+class ManualPaymentModel(private val scope: CoroutineScope, private val env: AppEnvironment) {
+    private val data = env.data
+    private val _draft = MutableStateFlow(ManualPaymentDraft())
+    val draft = _draft.asStateFlow()
+    private val _submitting = MutableStateFlow(false)
+    val submitting = _submitting.asStateFlow()
+    private val _recorded = MutableStateFlow(false)
+    val recorded = _recorded.asStateFlow()
+    val wallet = data.wallet.state
+
+    // Keep the detection after a partial failure, so retrying cannot create a second payment.
+    private var payment: DetectedPayment? = null
+
+    fun beginSession() {
+        if (_submitting.value || _recorded.value) return
+        payment = null
+        _draft.value = ManualPaymentDraft()
+    }
+
+    fun onAmountChange(text: String) {
+        if (canEdit()) _draft.value = _draft.value.withAmountText(text)
+    }
+
+    fun onMerchantChange(text: String) {
+        if (canEdit()) _draft.value = _draft.value.copy(merchant = text)
+    }
+
+    fun submit() {
+        val draft = _draft.value
+        if (_submitting.value || !draft.isValid) return
+        _submitting.value = true
+        scope.launch {
+            try {
+                val policy = data.settings.load().pullPolicy
+                val p = payment ?: DetectedPayment(
+                    id = PaymentId(data.ids.next()),
+                    amount = checkNotNull(draft.amount),
+                    merchant = draft.merchantOrNull,
+                    sourceApp = "manual",
+                    rawText = "",
+                    detectedAt = env.clock.now(),
+                    confidence = 1f,
+                    isRefund = false,
+                )
+                if (!_recorded.value) {
+                    data.wallet.recordDetectedPayment(p)
+                    payment = p
+                    _recorded.value = true
+                }
+                val settlement = data.wallet.settle(p.id, policy, manual = true).settlement
+                val paid = settlement.paidUnitIds.mapNotNull { data.wallet.state.value.units[it] }.total()
+                _draft.value = draft.copy(result = ManualPaymentResult(settlement, paid))
+                _recorded.value = false
+                env.haptics.success()
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                env.messages.show(Strings.failed(e.message))
+            } finally {
+                _submitting.value = false
+            }
+        }
+    }
+
+    private fun canEdit(): Boolean = !_submitting.value && !_recorded.value && _draft.value.result == null
+}
diff --git a/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentSheet.kt b/shared/ui/src/commonMain/kotlin/com/jim/realcash/ui/manual/ManualPaymentSheet.kt
