diff --git a/shared/ui/src/jvmTest/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraftTest.kt b/shared/ui/src/jvmTest/kotlin/com/jim/realcash/ui/manual/ManualPaymentDraftTest.kt
