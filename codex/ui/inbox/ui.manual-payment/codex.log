+    @Test
+    fun p_manualPaymentSheet() = runBlocking {
+        val data = newData().apply { seedAllowance(); seedHand(W10000) }
+        val app = newAppState(data)
+        app.openManualSheet()
+        app.manualPayment.onAmountChange("6500")
