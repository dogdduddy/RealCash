internal enum class PaymentLedgerStatus {
    /** Detected, waiting for settlement or rejection. */
    PENDING,

    /** Settled (automatically or manually). */
    SETTLED,

    /** Rejected by the user. */
    REJECTED,

    /** A refund detection whose units went back into the wallet. */
    REFUNDED,
}
