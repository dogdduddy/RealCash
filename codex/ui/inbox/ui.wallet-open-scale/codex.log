/** Placeholder colors of one denomination (used until pipeline images replace the Canvas faces). */
@Immutable
data class DenominationColors(
    /** Light end of the face gradient. */
    val light: Color,
    /** Dark end of the face gradient. */
    val dark: Color,
    /** Numeral / ornament color on top of the gradient. */
    val ink: Color,
)

/** Face colors per denomination: 50,000 yellow-ochre, 10,000 green-teal, 5,000 orange-red, 1,000 blue. */
fun Denomination.colors(): DenominationColors = when (this) {
    Denomination.W50000 -> DenominationColors(Color(0xFFE9C46A), Color(0xFFB07F1E), Color(0xFF4A3305))
    Denomination.W10000 -> DenominationColors(Color(0xFF6DBBA5), Color(0xFF256E5D), Color(0xFFFFFFFF))
    Denomination.W5000 -> DenominationColors(Color(0xFFF08D63), Color(0xFFB8431F), Color(0xFFFFFFFF))
    Denomination.W1000 -> DenominationColors(Color(0xFF7FA9DB), Color(0xFF2F5F99), Color(0xFFFFFFFF))
    Denomination.C500 -> DenominationColors(Color(0xFFE3E6EA), Color(0xFF9AA3AC), Color(0xFF39414A))
    Denomination.C100 -> DenominationColors(Color(0xFFDCE0E4), Color(0xFF8F98A2), Color(0xFF39414A))
    Denomination.C50 -> DenominationColors(Color(0xFFE6E2DA), Color(0xFFA49C8E), Color(0xFF443D31))
    Denomination.C10 -> DenominationColors(Color(0xFFE8B98F), Color(0xFFA9683A), Color(0xFF3E220D))
}

/**
 * Relative physical size: bills by width (154/148/142/136 mm), coins by diameter (26.5/24/21.6/18 mm),
 * normalised to the largest of their kind. Identification is color + numeral + size (design doc §5.5).
 */
val Denomination.relativeSize: Float
    get() = when (this) {
        Denomination.W50000, Denomination.W10000, Denomination.W5000, Denomination.W1000 -> billAspectRatio / BILL_ASPECT
        Denomination.C500 -> 1f
        Denomination.C100 -> 24f / 26.5f
        Denomination.C50 -> 21.6f / 26.5f
        Denomination.C10 -> 18f / 26.5f
    }

/** Width / height ratio of the largest bill (154 × 68 mm). */
const val BILL_ASPECT: Float = 154f / 68f

/** Physical face ratio; coins are square. The reviewed PNGs have these proportions within pixel rounding. */
val Denomination.billAspectRatio: Float
    get() = when (this) {
        Denomination.W50000 -> BILL_ASPECT
        Denomination.W10000 -> 148f / 68f
        Denomination.W5000 -> 142f / 68f
        Denomination.W1000 -> 136f / 68f
        else -> 1f
    }

private val BillCorner = 6.dp

/** Below this face height the small corner numeral is unreadable and is left out (chips, stepper rows). */
private val MIN_HEIGHT_FOR_CORNER_LABEL = 36.dp

/**
 * One bill or coin face; dispatches on [Denomination.kind].
 *
 * @param painter pipeline artwork; when `null` a Canvas placeholder is drawn.
 */
@Composable
fun MoneyFace(denomination: Denomination, modifier: Modifier = Modifier, painter: Painter? = null) {
    if (denomination.kind == Denomination.Kind.BILL) {
        BillFace(denomination, modifier, painter)
    } else {
        CoinFace(denomination, modifier, painter)
    }
}

/**
 * The face of a bill. The caller decides the size using [billAspectRatio].
 *
 * @param painter artwork from the image pipeline (design doc §5.5). When `null`, a Canvas placeholder is drawn:
 * a gradient in the denomination's color, a watermark disc, a fine inner frame and the numeral.
 */
@Composable
fun BillFace(denomination: Denomination, modifier: Modifier = Modifier, painter: Painter? = null) {
    val shape = RoundedCornerShape(if (painter != null) 1.dp else BillCorner)
    val label = "${denomination.faceLabel}원"
    Box(
        modifier = modifier
            .aspectRatio(denomination.billAspectRatio)
            .shadow(2.5.dp, shape)
            .clip(shape)
            .semantics { contentDescription = label },
    ) {
        if (painter != null) {
            Image(
                painter,
                contentDescription = null,
                contentScale = ContentScale.Fit,
                alpha = if (MaterialTheme.colorScheme.background.luminance() < 0.5f) 0.92f else 1f,
                modifier = Modifier.fillMaxSize(),
            )
        } else {
            BillPlaceholder(denomination)
        }
    }
}

@Composable
private fun BillPlaceholder(denomination: Denomination) {
    val c = denomination.colors()
    BoxWithConstraints(Modifier.fillMaxSize()) {
        val h = maxHeight
        Canvas(Modifier.fillMaxSize()) {
            drawRect(Brush.linearGradient(listOf(c.light, c.dark), start = Offset.Zero, end = Offset(size.width, size.height)))
            // Watermark disc on the left third.
            val r = size.height * 0.34f
            drawCircle(Color.White.copy(alpha = 0.22f), radius = r, center = Offset(size.width * 0.24f, size.height * 0.5f))
            drawCircle(
                Color.White.copy(alpha = 0.35f),
                radius = r * 0.78f,
                center = Offset(size.width * 0.24f, size.height * 0.5f),
                style = Stroke(width = size.height * 0.015f),
            )
            // Fine guilloche-like waves on the right.
            val step = size.height / 9f
            for (i in 1..7) {
                drawArc(
                    color = c.ink.copy(alpha = 0.08f),
                    startAngle = 200f,
                    sweepAngle = 140f,
                    useCenter = false,
                    topLeft = Offset(size.width * 0.45f + i * step * 0.6f, step * 0.5f),
                    size = Size(size.width * 0.55f, size.height - step),
                    style = Stroke(width = 1f),
                )
            }
            // Inner frame.
            val inset = size.height * 0.07f
            drawRoundRect(
                color = c.ink.copy(alpha = 0.25f),
                topLeft = Offset(inset, inset),
                size = Size(size.width - 2 * inset, size.height - 2 * inset),
                cornerRadius = CornerRadius(inset, inset),
                style = Stroke(width = 1.2f),
            )
        }
        val numeral = MaterialTheme.typography.titleLarge.copy(
            fontWeight = FontWeight.ExtraBold,
            fontSize = with(androidx.compose.ui.platform.LocalDensity.current) { (h * 0.30f).toSp() },
        )
        val small = MaterialTheme.typography.labelSmall.copy(
            fontWeight = FontWeight.Bold,
            fontSize = with(androidx.compose.ui.platform.LocalDensity.current) { (h * 0.14f).toSp() },
        )
        if (h >= MIN_HEIGHT_FOR_CORNER_LABEL) {
            Text(
                denomination.faceLabel,
                style = small,
                color = c.ink.copy(alpha = 0.85f),
                maxLines = 1,
                modifier = Modifier.align(Alignment.TopStart).padding(start = h * 0.14f, top = h * 0.11f),
            )
        }
        Text(
            denomination.faceLabel,
            style = numeral,
            color = c.ink,
            maxLines = 1,
            textAlign = TextAlign.End,
            modifier = Modifier.align(Alignment.BottomEnd).padding(end = h * 0.14f, bottom = h * 0.08f),
        )
    }
}

/**
 * The face of a coin (circle). The caller decides the size.
 *
 * @param painter artwork from the image pipeline; when `null`, a metallic radial gradient with a rim and the numeral.
 */
@Composable
fun CoinFace(denomination: Denomination, modifier: Modifier = Modifier, painter: Painter? = null) {
    val c = denomination.colors()
    val label = "${denomination.faceLabel}원"
    BoxWithConstraints(
        modifier = modifier
            .shadow(4.dp, CircleShape)
            .clip(CircleShape)
            .semantics { contentDescription = label },
        contentAlignment = Alignment.Center,
    ) {
        if (painter != null) {
            Image(
                painter,
                contentDescription = null,
                contentScale = ContentScale.Fit,
                alpha = if (MaterialTheme.colorScheme.background.luminance() < 0.5f) 0.92f else 1f,
                modifier = Modifier.fillMaxSize(),
            )
        } else {
            val d = minOf(maxWidth, maxHeight)
            Canvas(Modifier.fillMaxSize()) {
                val radius = size.minDimension / 2f
                drawCircle(
                    Brush.radialGradient(listOf(c.light, c.dark), center = Offset(radius * 0.7f, radius * 0.6f), radius = radius * 1.5f),
                    radius = radius,
                )
                drawCircle(c.ink.copy(alpha = 0.25f), radius = radius * 0.82f, style = Stroke(width = radius * 0.06f))
            }
            Text(
                denomination.faceLabel,
                style = MaterialTheme.typography.labelSmall.copy(
                    fontWeight = FontWeight.Bold,
                    fontSize = with(androidx.compose.ui.platform.LocalDensity.current) { (d * 0.30f).toSp() },
                ),
                color = c.ink,
                maxLines = 1,
            )
        }
    }
}

/** Offset of one back layer in a stack. */
private val LayerStep = 3.dp

/** Maximum number of back layers drawn behind the front face. */
private const val MAX_BACK_LAYERS = 3

/**
 * A stack of [count] bills of one denomination: the front face plus up to three offset back layers
 * (HardPay's `backLayers` idea) and a count badge. Fills the available width scaled by [Denomination.relativeSize].
 *
 * The stack always reserves room for the maximum offset so that stacks of different counts line up.
 *
 * @param painter pipeline artwork passed to every [BillFace] of the stack.
 * @param onClick tap action (T5b: take one bill out); `null` = not clickable.
 */
@Composable
fun BillStack(
    denomination: Denomination,
    count: Int,
    modifier: Modifier = Modifier,
    painter: Painter? = null,
    onClick: (() -> Unit)? = null,
) {
    val backLayers = (count - 1).coerceIn(0, MAX_BACK_LAYERS)
    val reserve = LayerStep * MAX_BACK_LAYERS
    Box(modifier.padding(end = reserve, bottom = reserve, top = 6.dp)) {
        val faceModifier = Modifier.fillMaxWidth(denomination.relativeSize).aspectRatio(denomination.billAspectRatio)
        repeat(backLayers) { i ->
            val depth = backLayers - i
            BillFace(
                denomination,
                faceModifier.offset(x = LayerStep * depth, y = LayerStep * depth).alpha(0.75f),
                painter,
            )
        }
        BillFace(
            denomination,
            if (onClick != null) faceModifier.clickable(onClick = onClick) else faceModifier,
            painter,
        )
        CountBadge(count, Modifier.align(Alignment.TopEnd).offset(x = reserve - 2.dp, y = (-6).dp))
    }
}

/**
 * A stack of [count] coins of one denomination: the front coin plus up to three darker back layers below it,
 * and a count badge.
 *
 * @param size diameter of the largest coin (500원); smaller coins scale by [Denomination.relativeSize].
 */
@Composable
fun CoinStack(
    denomination: Denomination,
    count: Int,
    modifier: Modifier = Modifier,
    size: Dp = 46.dp,
    painter: Painter? = null,
    onClick: (() -> Unit)? = null,
) {
    val backLayers = (count - 1).coerceIn(0, MAX_BACK_LAYERS)
    val reserve = LayerStep * MAX_BACK_LAYERS
    val d = size * denomination.relativeSize
    Box(modifier.size(width = size + 10.dp, height = size + reserve + 6.dp), contentAlignment = Alignment.BottomCenter) {
        repeat(backLayers) { i ->
            val depth = backLayers - i
            CoinFace(
                denomination,
                Modifier.size(d).offset(y = -reserve + LayerStep * depth).drawWithContent {
                    drawContent()
                    drawCircle(Color.Black.copy(alpha = 0.18f), radius = this.size.minDimension / 2f)
                },
                painter,
            )
        }
        val front = Modifier.size(d).offset(y = -reserve)
        CoinFace(denomination, if (onClick != null) front.clickable(onClick = onClick) else front, painter)
        CountBadge(count, Modifier.align(Alignment.TopEnd))
    }
}

/** Small pill showing `×N`. Hidden for N <= 1. */
@Composable
fun CountBadge(count: Int, modifier: Modifier = Modifier) {
    if (count <= 1) return
    Text(
        "×$count",
        style = MaterialTheme.typography.labelSmall.copy(fontWeight = FontWeight.Bold),
        color = MaterialTheme.colorScheme.onSecondaryContainer,
        modifier = modifier
            .background(MaterialTheme.colorScheme.secondaryContainer, RoundedCornerShape(50))
            .padding(horizontal = 6.dp, vertical = 1.dp),
    )
}

/**
 * Compact chip for one denomination and count (used in the "손에 든 돈" card): a miniature face and `×N`.
 */
@Composable
fun UnitChip(denomination: Denomination, count: Int, modifier: Modifier = Modifier, painter: Painter? = null) {
    Row(
        modifier
            .background(MaterialTheme.colorScheme.surfaceContainerLowest, RoundedCornerShape(50))
            .padding(start = 6.dp, end = 10.dp, top = 4.dp, bottom = 4.dp),
        verticalAlignment = Alignment.CenterVertically,
    ) {
        if (denomination.kind == Denomination.Kind.BILL) {
            BillFace(denomination, Modifier.size(width = 22.dp * denomination.billAspectRatio, height = 22.dp), painter)
        } else {
            CoinFace(denomination, Modifier.size(20.dp), painter)
        }
        Spacer(Modifier.width(6.dp))
        Text(
            "×$count",
            style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.SemiBold),
            color = MaterialTheme.colorScheme.onSurface,
        )
    }
}
package com.jim.realcash.ui.walletopen

import com.jim.realcash.domain.model.CashUnit
import com.jim.realcash.domain.model.CashUnitId
import com.jim.realcash.domain.model.CashUnitState
import com.jim.realcash.domain.model.total
import com.jim.realcash.ui.AppEnvironment
import com.jim.realcash.ui.launchCatching
import kotlin.random.Random
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.SharingStarted
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.combine
import kotlinx.coroutines.flow.stateIn

/** Presentation-only selection; all ledger mutations stay in WalletRepository. */
data class WalletOpenUi(val inWallet: List<CashUnit>, val inHand: List<CashUnit>, val changed: Boolean) {
    val handTotal get() = inHand.total()
    val walletTotal get() = inWallet.total()
}

class WalletOpenModel(private val scope: CoroutineScope, private val env: AppEnvironment, val seed: Int = Random.nextInt()) {
    private val repository = env.data.wallet
    private val choices = MutableStateFlow<Map<CashUnitId, Boolean>>(emptyMap())
    private val _submitting = MutableStateFlow(false)
    val submitting = _submitting.asStateFlow()
    private val _paymentInfoOpen = MutableStateFlow(false)
    val paymentInfoOpen = _paymentInfoOpen.asStateFlow()

    private fun present(): WalletOpenUi = present(repository.state.value.inWallet + repository.state.value.inHand, choices.value)
    private fun present(units: List<CashUnit>, selection: Map<CashUnitId, Boolean>): WalletOpenUi {
        val hand = units.filter { selection[it.id] ?: (it.state == CashUnitState.IN_HAND) }
        val handIds = hand.map { it.id }.toSet()
        return WalletOpenUi(units.filter { it.id !in handIds }, hand,
            units.any { (it.id in handIds) != (it.state == CashUnitState.IN_HAND) })
    }

    val ui = combine(repository.state, choices) { state, selection ->
        present(state.inWallet + state.inHand, selection)
    }.stateIn(scope, SharingStarted.WhileSubscribed(5_000), present())

    fun toggle(id: CashUnitId) {
        if (_submitting.value) return
        val unit = repository.state.value.units[id] ?: return
        if (unit.state != CashUnitState.IN_WALLET && unit.state != CashUnitState.IN_HAND) return
        val selected = choices.value[id] ?: (unit.state == CashUnitState.IN_HAND)
        choices.value = choices.value + (id to !selected)
        env.haptics.tap()
    }

    fun showPaymentInfo() { _paymentInfoOpen.value = true }
    fun closePaymentInfo() { _paymentInfoOpen.value = false }

    /** One moveToHand per confirmation; repeated taps are ignored until the write finishes. */
    fun confirm(onSaved: () -> Unit = {}) {
        if (_submitting.value) return
        if (!present().changed) { onSaved(); return }
        _submitting.value = true
        scope.launchCatching(env.messages) {
            try {
                val ttl = env.data.settings.load().handTtl
                val state = repository.state.value
                val draft = present()
                val ids = draft.inHand.map { it.id }
                // Preserve the whole draft if returning the previous hand succeeds but the next write fails.
                choices.value = (draft.inWallet + draft.inHand).associate { it.id to (it.id in ids) }
                if (state.activeHand != null) repository.returnHand()
                if (ids.isNotEmpty()) repository.moveToHand(ids, ttl = ttl)
                choices.value = emptyMap()
                env.haptics.success()
                onSaved()
            } finally {
                _submitting.value = false
            }
        }
    }
}
package com.jim.realcash.domain.model

import kotlinx.serialization.Serializable

/** The eight Korean cash denominations, from the 50,000원 bill down to the 10원 coin. */
@Serializable
enum class Denomination(
    /** Face value in won. */
    val won: Int,
    /** Whether this denomination is a bill or a coin. */
    val kind: Kind,
) {
    /** 50,000원 bill. */
    W50000(50_000, Kind.BILL),

    /** 10,000원 bill. */
    W10000(10_000, Kind.BILL),

    /** 5,000원 bill. */
    W5000(5_000, Kind.BILL),

    /** 1,000원 bill. */
    W1000(1_000, Kind.BILL),

    /** 500원 coin. */
    C500(500, Kind.COIN),

    /** 100원 coin. */
    C100(100, Kind.COIN),

    /** 50원 coin. */
    C50(50, Kind.COIN),

    /** 10원 coin. */
    C10(10, Kind.COIN),
    ;

    /** Face value as [Won]. */
    val amount: Won get() = Won(won)

    /** Physical kind of a denomination. */
    enum class Kind {
        /** Paper bill. */
        BILL,

        /** Metal coin. */
        COIN,
    }

    /** Lookup helpers. */
    companion object {
        /** All denominations ordered from largest to smallest face value. */
        val descending: List<Denomination> = entries.sortedByDescending { it.won }

        /** All denominations ordered from smallest to largest face value. */
        val ascending: List<Denomination> = descending.reversed()

        /** The denomination whose face value is exactly [won], or `null` if there is none. */
        fun of(won: Int): Denomination? = entries.firstOrNull { it.won == won }
    }
}

/** Total value of a denomination-to-count map. */
fun Map<Denomination, Int>.total(): Won = Won(entries.sumOf { (d, n) -> d.won * n })
