/**
 * The RealCash app: theme, wallet menu, hand-rolled navigation and the payment confirmation sheet.
 *
 * Creates the [AppState] (and with it the screen models) in a composition-scoped coroutine scope and loads the
 * settings and the wallet ledger once.
 *
 * @param data the process-wide data graph.
 * @param haptics platform haptics.
 * @param showDebugShortcut adds a notification-simulator item to the wallet menu (desktop builds).
 * @param clock time source; override for previews and screenshots.
 * @param timeZone zone for dates and times; override for previews and screenshots.
 * @param darkTheme dark palette; follows the system by default.
 * @param platformDebugEntries platform-only screens listed in 설정 → 디버그 (Android: notification access and the
 *   notification sample collector). Desktop and iOS pass nothing.
 */
@Composable
fun RealCashApp(
    data: RealCashData,
    haptics: Haptics,
    showDebugShortcut: Boolean = false,
    clock: Clock = Clock.System,
    timeZone: TimeZone = TimeZone.currentSystemDefault(),
    darkTheme: Boolean = isSystemInDarkTheme(),
    platformDebugEntries: List<DebugEntry> = emptyList(),
) {
    val scope = rememberCoroutineScope()
    val appState = remember(data) { AppState(AppEnvironment(data, haptics, UiMessages(), clock, timeZone), scope) }
    LaunchedEffect(appState) { appState.start() }
    RealCashTheme(darkTheme) {
        RealCashRoot(appState, showDebugShortcut, platformDebugEntries = platformDebugEntries)
    }
}

// NOTE(T3): the one extension point for platform code. A platform host (the Android app) contributes debug screens
// that only exist there; 설정 → 디버그 lists them under the simulator and opens them as a pushed [PlatformDebugScreen],
// so they share the back stack and back handling of every other pushed screen.
/**
 * A platform-only debug screen listed in 설정 → 디버그.
 *
 * @property title row title, also used by the screen's own header.
 * @property description one line under the title.
 * @property content the screen; call `onBack` from its back button.
 */
class DebugEntry(
    val title: String,
    val description: String? = null,
    val content: @Composable (onBack: () -> Unit) -> Unit,
)

/** Pushed screen showing `platformDebugEntries[index]` (declared here, next to [DebugEntry]; part of [Screen]). */
data class PlatformDebugScreen(val index: Int) : Screen

/**
 * Everything below the theme, driven by an existing [appState]. Used by [RealCashApp] and by the screenshot tests,
 * which prepare the back stack and the sheet before rendering.
 */
@OptIn(ExperimentalMaterial3Api::class, ExperimentalComposeUiApi::class)
@Composable
fun RealCashRoot(
    appState: AppState,
    showDebugShortcut: Boolean = false,
    modifier: Modifier = Modifier,
    platformDebugEntries: List<DebugEntry> = emptyList(),
) {
    LaunchedEffect(appState) {
        appState.env.messages.messages.collect { appState.snackbarHostState.showSnackbar(it) }
    }
    // The platform back event (Android back button / gesture) pops the back stack; at the home
    // it is not consumed, so the system handles it. No-op where the platform sends no back events (desktop window).
    BackHandler(enabled = appState.canGoBack) { appState.back() }
    CompositionLocalProvider(LocalMoneyArt provides ResourceMoneyArt) {
        Scaffold(
            modifier = modifier,
            containerColor = MaterialTheme.colorScheme.background,
            snackbarHost = { SnackbarHost(appState.snackbarHostState) },
        ) { padding ->
            Box(Modifier.fillMaxSize().padding(padding)) {
                when (val screen = appState.current) {
                    Screen.WalletHome, Screen.WalletOpen -> WalletScene(appState, showDebugShortcut)
                    Screen.Ledger -> LedgerScreen(appState.ledger, appState.env.timeZone, onBack = { appState.back() })
                    Screen.Settings -> SettingsScreen(
                        model = appState.settings,
                        onBack = { appState.back() },
                        onOpenSimulator = { appState.navigate(Screen.NotificationSimulator) },
                        platformEntries = platformDebugEntries,
                        onOpenPlatformEntry = { index -> appState.navigate(PlatformDebugScreen(index)) },
                    )
                    Screen.ReceiveAllowance -> {
                        val model = remember { appState.receiveAllowance }
                        ReceiveAllowanceScreen(model, onBack = { appState.back() })
                    }
                    Screen.NotificationSimulator -> NotificationSimulatorScreen(appState.simulator, onBack = { appState.back() })
                    is Screen.TakeOut -> {
                        val model = remember(screen) { appState.takeOut }
                        TakeOutScreen(model, onBack = { appState.back() })
                    }
                    Screen.Exchange -> {
                        val model = remember { appState.exchange }
                        ExchangeScreen(model, onBack = { appState.back() })
                    }
                    is PlatformDebugScreen -> platformDebugEntries.getOrNull(screen.index)?.content?.invoke { appState.back() }
                }
            }
        }
        if (appState.confirmSheetOpen) {
            ConfirmPaymentsSheet(appState.confirmPayments, onDismiss = appState::closeConfirmSheet)
        }
        if (appState.manualSheetOpen) {
            ManualPaymentSheet(appState.manualPayment, onDismiss = appState::closeManualSheet, snackbarHostState = appState.snackbarHostState)
        }
    }
}

/** Keeps both wallet faces alive during the open/close transition. */
@Composable
private fun WalletScene(appState: AppState, showDebugShortcut: Boolean) {
    val open = appState.current == Screen.WalletOpen
    val transition = updateTransition(open, label = "wallet")
    val opening by transition.animateFloat(
        transitionSpec = { tween(durationMillis = if (targetState) 360 else 220) },
        label = "wallet-opening",
    ) { if (it) 1f else 0f }
    Box(Modifier.fillMaxSize()) {
        if (opening < 1f) {
            WalletHomeScreen(
                model = appState.walletHome,
                onReceiveAllowance = { appState.navigate(Screen.ReceiveAllowance) },
                onOpenPending = appState::openConfirmSheet,
                onOpenWallet = appState::openWallet,
                opening = opening,
                enabled = !open,
                modifier = Modifier.graphicsLayer { alpha = 1f - opening },
                menu = { WalletMenu(appState, showDebugShortcut) },
            )
        }
        if (opening > 0f) {
            Column(Modifier.fillMaxSize().graphicsLayer { alpha = opening }) {
                ScreenHeader(Strings.WALLET, onBack = { if (open) appState.back() })
                Surface(
                    color = MaterialTheme.colorScheme.surfaceContainer,
                    shape = MaterialTheme.shapes.extraLarge,
                    modifier = Modifier.fillMaxWidth().padding(24.dp).height(180.dp),
                ) {
                    Box(contentAlignment = Alignment.Center) {
                        Text(Strings.WALLET_OPEN_LAYOUT, style = MaterialTheme.typography.bodyMedium)
                    }
                }
            }
        }
    }
}

/** All secondary destinations live in this menu; settings retains the platform debug entries. */
@Composable
private fun WalletMenu(appState: AppState, showDebugShortcut: Boolean) {
    var expanded by remember { mutableStateOf(false) }
    fun choose(action: () -> Unit) {
        expanded = false
        action()
    }
    Box {
        IconButton(onClick = { expanded = true }, modifier = Modifier.semantics { contentDescription = Strings.HOME_MENU }) {
            RcIconGlyph(RcIcon.MORE)
        }
        DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
            DropdownMenuItem(text = { Text(Strings.RECEIVE_ALLOWANCE) }, onClick = { choose { appState.navigate(Screen.ReceiveAllowance) } })
            DropdownMenuItem(text = { Text(Strings.EXCHANGE) }, onClick = { choose { appState.navigate(Screen.Exchange) } })
            DropdownMenuItem(text = { Text(Strings.MANUAL_TITLE) }, onClick = { choose(appState::openManualSheet) })
            DropdownMenuItem(text = { Text(Strings.TAB_LEDGER) }, onClick = { choose { appState.navigate(Screen.Ledger) } })
            DropdownMenuItem(text = { Text(Strings.TAB_SETTINGS) }, onClick = { choose { appState.navigate(Screen.Settings) } })
            if (showDebugShortcut) {
                DropdownMenuItem(text = { Text(Strings.SIMULATOR_SHORTCUT) }, onClick = { choose { appState.navigate(Screen.NotificationSimulator) } })
            }
        }
    }
}
package com.jim.realcash.ui.takeout

import com.jim.realcash.domain.ledger.ReturnReason
import com.jim.realcash.domain.ledger.WalletState
import com.jim.realcash.domain.model.CashUnit
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.domain.model.HandId
import com.jim.realcash.ui.AppEnvironment
import com.jim.realcash.ui.Strings
import com.jim.realcash.ui.format.formatted
import com.jim.realcash.ui.launchCatching
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update

/**
 * State holder of the 꺼내기 screen.
 *
 * @param refill "더 꺼내기": the current hand's units start out picked and are pickable together with the wallet.
 * @param onDone called after the hand was taken out (navigates back).
 */
class TakeOutModel(
    private val scope: CoroutineScope,
    private val env: AppEnvironment,
    val refill: Boolean,
    private val onDone: () -> Unit,
) {
    private val wallet = env.data.wallet

    /** The hand being refilled, if any (captured when the screen opens). */
    private val refillHandId: HandId? = if (refill) wallet.state.value.activeHand?.id else null

    private val _draft = MutableStateFlow(initialDraft(wallet.state.value))
    private val _submitting = MutableStateFlow(false)

    /** The editable draft. */
    val draft: StateFlow<TakeOutDraft> = _draft.asStateFlow()

    /** True while the hand is being written. */
    val submitting: StateFlow<Boolean> = _submitting.asStateFlow()

    /** Drag & drop state of the screen (kept here so it survives recomposition and tests can drive it). */
    val drag = DragDropState()

    private fun initialDraft(state: WalletState): TakeOutDraft {
        val hand = state.activeHand?.takeIf { it.id == refillHandId }
        return TakeOutDraft.of(availableIn(state), picked = hand?.unitIds.orEmpty(), expected = hand?.expectedAmount)
    }

    private fun availableIn(state: WalletState): List<CashUnit> {
        val refilling = refillHandId != null && state.activeHand?.id == refillHandId
        return if (refilling) state.inWallet + state.inHand else state.inWallet
    }

    /** Keeps the draft in sync with the wallet while the screen is shown (run it in a `LaunchedEffect`). */
    suspend fun syncWithWallet() {
        wallet.state.collect { state -> _draft.update { it.rebase(availableIn(state)) } }
    }

    /** The expected amount field changed. */
    fun onExpectedChange(text: String) = _draft.update { it.withExpectedText(text) }

    /** Tap on a stack (fallback to dragging): picks one unit of [denomination]. */
    fun tapAdd(denomination: Denomination) {
        if (_draft.value.remaining(denomination) == 0) return
        env.haptics.tap()
        _draft.update { it.add(denomination) }
    }

    /** A drag started on a stack. */
    fun onDragStart() = env.haptics.pickUp()

    /** A dragged unit entered the hand zone. */
    fun onEnterZone() = env.haptics.tap()

    /** A dragged unit of [denomination] was dropped on the hand zone. */
    fun drop(denomination: Denomination) {
        if (_draft.value.remaining(denomination) == 0) return
        env.haptics.success()
        _draft.update { it.add(denomination) }
    }

    /** Tap on a chip in the hand zone: puts one unit of [denomination] back. */
    fun putBack(denomination: Denomination) {
        env.haptics.tap()
        _draft.update { it.remove(denomination) }
    }

    /** "잔돈으로 딱 맞추기". */
    fun fitExact() {
        env.haptics.tap()
        _draft.update { it.fitExact() }
    }

    /** "가장 적은 장수로". */
    fun fewest() {
        env.haptics.tap()
        _draft.update { it.fewest() }
    }

    /** "손에 들기": moves the picked units into a new hand with the configured TTL, then calls `onDone`. */
    fun confirm() {
        val d = _draft.value
        if (!d.canConfirm || _submitting.value) return
        _submitting.value = true
        scope.launchCatching(env.messages) {
            try {
                val ttl = env.data.settings.load().handTtl
                // NOTE: only one hand can be active (engineering plan §1), so "더 꺼내기" puts the current hand back
                // and takes the combined pick out as a new hand. These are two ledger events, not one atomic step;
                // if the second one fails the cash simply stays in the wallet and the error is shown.
                if (refillHandId != null && wallet.state.value.activeHand?.id == refillHandId) {
                    wallet.returnHand(ReturnReason.USER)
                }
                wallet.moveToHand(d.pickedIds, expectedAmount = d.expected, memo = null, ttl = ttl)
                env.haptics.success()
                env.messages.show(Strings.heldInHand(d.pickedTotal.formatted()))
                onDone()
            } finally {
                _submitting.value = false
            }
        }
    }
}
package com.jim.realcash.ui.takeout

import com.jim.realcash.domain.calc.ChangeCalculator
import com.jim.realcash.domain.calc.PullSelector
import com.jim.realcash.domain.model.CashUnit
import com.jim.realcash.domain.model.CashUnitId
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.domain.model.PullPolicy
import com.jim.realcash.domain.model.Won
import com.jim.realcash.domain.model.total
import com.jim.realcash.ui.format.AmountInput
import com.jim.realcash.ui.wallet.DenominationCount

/** The live line under the expected amount: how the picked cash compares with what the user expects to pay. */
sealed interface TakeOutFeedback {
    /** No expected amount entered: nothing to compare. */
    data object None : TakeOutFeedback

    /**
     * The picked cash does not cover the expected amount.
     *
     * @property missing what is still missing.
     * @property walletTotal set when even everything available cannot cover the expected amount ("지갑에 ₩x 남았어요");
     *   [missing] is then the shortfall of the whole wallet.
     */
    data class Short(val missing: Won, val walletTotal: Won? = null) : TakeOutFeedback

    /** The picked cash matches the expected amount exactly. */
    data object Exact : TakeOutFeedback

    /**
     * The picked cash exceeds the expected amount; [change] is what a shop would hand back (fewest units).
     *
     * @property over picked total minus the (cash-rounded) expected amount.
     */
    data class Over(val over: Won, val change: Map<Denomination, Int>) : TakeOutFeedback {
        /** Total of [change]; equals [over]. */
        val changeTotal: Won get() = change.total()
    }
}

/** What the last helper button ("잔돈으로 딱 맞추기" / "가장 적은 장수로") did; shown under the helpers. */
sealed interface TakeOutHelperResult {
    /** An exact subset was found and picked. */
    data class Exact(val total: Won) : TakeOutHelperResult

    /** No exact subset exists; the LARGEST_FIRST fallback of [PullSelector] was picked instead. */
    data class NotExact(val total: Won) : TakeOutHelperResult

    /** FEWEST_UNITS picked [count] units worth [total]. */
    data class Fewest(val count: Int, val total: Won) : TakeOutHelperResult

    /** Everything available was picked and still [shortfall] is missing. */
    data class Shortfall(val shortfall: Won) : TakeOutHelperResult
}

/**
 * Editable state of the 꺼내기 screen (pure; unit-tested).
 *
 * [available] are the units that may be picked (the wallet, plus the current hand when refilling). Picking a
 * denomination takes its oldest unpicked unit (the same order [PullSelector] uses); putting one back releases the
 * most recently picked unit of that denomination.
 *
 * NOTE: comparisons use the expected amount rounded up to 10원 ([Won.roundUpToCash]), because that is what a
 * 6,505원 card payment costs in cash; the change estimate therefore always is a valid cash amount.
 */
data class TakeOutDraft(
    /** Pickable units, largest denomination first, oldest first within a denomination. Build with [of]. */
    val available: List<CashUnit>,
    /** Picked unit ids in pick order. Always a subset of [available]. */
    val picked: List<CashUnitId> = emptyList(),
    /** Digits of the expected amount field (no separators). */
    val expectedDigits: String = "",
    /** Result of the last helper, cleared by any manual change. */
    val helper: TakeOutHelperResult? = null,
) {
    private val pickedSet: Set<CashUnitId> by lazy { picked.toSet() }

    /** The expected amount, or `null` when the field is empty or zero. */
    val expected: Won? get() = AmountInput.parse(expectedDigits)?.takeIf { it.value > 0 }

    /** [expected] rounded up to 10원, the cash that has to leave the wallet. */
    val cashExpected: Won? get() = expected?.roundUpToCash()

    /** Picked units, largest denomination first. */
    val pickedUnits: List<CashUnit> get() = available.filter { it.id in pickedSet }

    /** Picked unit ids, largest denomination first (the order handed to `moveToHand`). */
    val pickedIds: List<CashUnitId> get() = pickedUnits.map { it.id }

    /** Total of the picked units. */
    val pickedTotal: Won get() = pickedUnits.total()

    /** Total of everything available. */
    val availableTotal: Won get() = available.total()

    /** Picked count per denomination, largest first, zeros omitted. */
    val pickedCounts: List<DenominationCount> get() = countsOf(pickedUnits)

    /** Bills still available per denomination (zero counts kept, so emptied stacks stay visible dimmed). */
    val remainingBills: List<DenominationCount> get() = remainingOfKind(Denomination.Kind.BILL)

    /** Coins still available per denomination (zero counts kept). */
    val remainingCoins: List<DenominationCount> get() = remainingOfKind(Denomination.Kind.COIN)

    /** Units of [denomination] that can still be picked. */
    fun remaining(denomination: Denomination): Int = available.count { it.denomination == denomination && it.id !in pickedSet }

    /** Picked units of [denomination]. */
    fun pickedCount(denomination: Denomination): Int = available.count { it.denomination == denomination && it.id in pickedSet }

    /** The live comparison with the expected amount. */
    val feedback: TakeOutFeedback
        get() {
            val target = cashExpected ?: return TakeOutFeedback.None
            val total = pickedTotal
            return when {
                availableTotal < target && total < target -> TakeOutFeedback.Short(target - availableTotal, availableTotal)
                total < target -> TakeOutFeedback.Short(target - total)
                total == target -> TakeOutFeedback.Exact
                else -> (total - target).let { TakeOutFeedback.Over(it, ChangeCalculator.minimalChange(it)) }
            }
        }

    /** True when "손에 들기" can run. */
    val canConfirm: Boolean get() = picked.isNotEmpty()

    /** True when the helper buttons can run (they need an expected amount). */
    val helpersEnabled: Boolean get() = cashExpected != null && available.isNotEmpty()

    /** Picks the oldest unpicked unit of [denomination]; unchanged when none is left. */
    fun add(denomination: Denomination): TakeOutDraft {
        val unit = available.firstOrNull { it.denomination == denomination && it.id !in pickedSet } ?: return this
        return copy(picked = picked + unit.id, helper = null)
    }

    /** Puts back the most recently picked unit of [denomination]; unchanged when none is picked. */
    fun remove(denomination: Denomination): TakeOutDraft {
        val byId = available.associateBy { it.id }
        val index = picked.indexOfLast { byId[it]?.denomination == denomination }
        if (index < 0) return this
        return copy(picked = picked.filterIndexed { i, _ -> i != index }, helper = null)
    }

    /** Puts everything back. */
    fun clear(): TakeOutDraft = copy(picked = emptyList(), helper = null)

    /** New expected amount text (digits only are kept). */
    fun withExpectedText(text: String): TakeOutDraft = copy(expectedDigits = AmountInput.sanitize(text), helper = null)

    /**
     * "잔돈으로 딱 맞추기": replaces the picks with [PullSelector] EXACT_IF_POSSIBLE over everything available
     * (small change first when several exact subsets exist). Unchanged without an expected amount.
     */
    fun fitExact(): TakeOutDraft = pull(PullPolicy.EXACT_IF_POSSIBLE)

    /** "가장 적은 장수로": replaces the picks with [PullSelector] FEWEST_UNITS. Unchanged without an expected amount. */
    fun fewest(): TakeOutDraft = pull(PullPolicy.FEWEST_UNITS)

    /** Same draft over a new set of [units] (the wallet changed underneath); picks that disappeared are dropped. */
    fun rebase(units: List<CashUnit>): TakeOutDraft {
        val sorted = units.sortedWith(UNIT_ORDER)
        if (sorted == available) return this
        val ids = sorted.mapTo(HashSet()) { it.id }
        return copy(available = sorted, picked = picked.filter { it in ids })
    }

    private fun pull(policy: PullPolicy): TakeOutDraft {
        val target = cashExpected ?: return this
        if (available.isEmpty()) return this
        val result = PullSelector.select(available, target, policy)
        val outcome = when {
            result.shortfall.value > 0 -> TakeOutHelperResult.Shortfall(result.shortfall)
            policy == PullPolicy.FEWEST_UNITS -> TakeOutHelperResult.Fewest(result.unitIds.size, result.total)
            result.total == target -> TakeOutHelperResult.Exact(result.total)
            else -> TakeOutHelperResult.NotExact(result.total)
        }
        return copy(picked = result.unitIds, helper = outcome)
    }

    private fun remainingOfKind(kind: Denomination.Kind): List<DenominationCount> =
        Denomination.descending
            .filter { it.kind == kind && available.any { u -> u.denomination == it } }
            .map { DenominationCount(it, remaining(it)) }

    /** Builders. */
    companion object {
        /** Largest denomination first; oldest unit first within a denomination; id as the final tiebreaker. */
        internal val UNIT_ORDER: Comparator<CashUnit> =
            compareByDescending<CashUnit> { it.denomination.won }.thenBy { it.acquiredAt }.thenBy { it.id.value }

        /** A draft over [available] with optional initial [picked] ids (unknown ids are dropped) and [expected] amount. */
        fun of(available: List<CashUnit>, picked: List<CashUnitId> = emptyList(), expected: Won? = null): TakeOutDraft {
            val sorted = available.sortedWith(UNIT_ORDER)
            val ids = sorted.mapTo(HashSet()) { it.id }
            return TakeOutDraft(
                available = sorted,
                picked = picked.filter { it in ids }.distinct(),
                expectedDigits = expected?.takeIf { it.value > 0 }?.value?.toString().orEmpty(),
            )
        }

        private fun countsOf(units: List<CashUnit>): List<DenominationCount> {
            val counts = units.groupingBy { it.denomination }.eachCount()
            return Denomination.descending.filter { it in counts }.map { DenominationCount(it, counts.getValue(it)) }
        }
    }
}

