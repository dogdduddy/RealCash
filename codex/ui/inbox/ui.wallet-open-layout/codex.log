/** The few glyphs the shell needs. Drawn on a Canvas to avoid pulling in an icon library. */
enum class RcIcon { WALLET, LEDGER, SETTINGS, BACK, CLOSE, MORE }

/**
 * Draws [icon] as a 24dp line glyph in [tint] (the current content color by default).
 * Decorative: callers put the meaning in an adjacent label or a contentDescription on the clickable parent.
 */
@Composable
fun RcIconGlyph(icon: RcIcon, modifier: Modifier = Modifier, tint: Color = LocalContentColor.current) {
    Canvas(modifier.size(24.dp)) {
        val s = size.minDimension
        val stroke = Stroke(width = s * 0.085f, cap = StrokeCap.Round)
        when (icon) {
            RcIcon.MORE -> {
                for (x in listOf(0.22f, 0.5f, 0.78f)) drawCircle(tint, radius = s * 0.065f, center = Offset(s * x, s * 0.5f))
            }
            RcIcon.WALLET -> {
                drawRoundRect(tint, Offset(s * 0.12f, s * 0.25f), Size(s * 0.76f, s * 0.56f), CornerRadius(s * 0.1f), style = stroke)
                drawLine(tint, Offset(s * 0.2f, s * 0.25f), Offset(s * 0.68f, s * 0.12f), stroke.width, StrokeCap.Round)
                drawCircle(tint, radius = s * 0.055f, center = Offset(s * 0.7f, s * 0.53f))
            }
            RcIcon.LEDGER -> {
                drawRoundRect(tint, Offset(s * 0.2f, s * 0.12f), Size(s * 0.6f, s * 0.76f), CornerRadius(s * 0.06f), style = stroke)
                for (i in 0..2) {
                    val y = s * (0.34f + i * 0.17f)
                    drawLine(tint, Offset(s * 0.33f, y), Offset(s * 0.67f, y), stroke.width * 0.8f, StrokeCap.Round)
                }
            }
            RcIcon.SETTINGS -> {
                val c = Offset(s / 2, s / 2)
                drawCircle(tint, radius = s * 0.24f, center = c, style = stroke)
                drawCircle(tint, radius = s * 0.08f, center = c, style = stroke)
                for (i in 0 until 8) {
                    val a = i * PI / 4
                    val from = Offset(c.x + cos(a).toFloat() * s * 0.29f, c.y + sin(a).toFloat() * s * 0.29f)
                    val to = Offset(c.x + cos(a).toFloat() * s * 0.4f, c.y + sin(a).toFloat() * s * 0.4f)
                    drawLine(tint, from, to, stroke.width * 1.3f, StrokeCap.Round)
                }
            }
            RcIcon.BACK -> {
                drawLine(tint, Offset(s * 0.2f, s * 0.5f), Offset(s * 0.82f, s * 0.5f), stroke.width, StrokeCap.Round)
                drawLine(tint, Offset(s * 0.2f, s * 0.5f), Offset(s * 0.45f, s * 0.25f), stroke.width, StrokeCap.Round)
                drawLine(tint, Offset(s * 0.2f, s * 0.5f), Offset(s * 0.45f, s * 0.75f), stroke.width, StrokeCap.Round)
            }
            RcIcon.CLOSE -> {
                drawLine(tint, Offset(s * 0.25f, s * 0.25f), Offset(s * 0.75f, s * 0.75f), stroke.width, StrokeCap.Round)
                drawLine(tint, Offset(s * 0.75f, s * 0.25f), Offset(s * 0.25f, s * 0.75f), stroke.width, StrokeCap.Round)
            }
        }
    }
}
package com.jim.realcash.ui.format

import androidx.compose.ui.text.AnnotatedString
import androidx.compose.ui.text.input.OffsetMapping
import androidx.compose.ui.text.input.TransformedText
import androidx.compose.ui.text.input.VisualTransformation
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.domain.model.Won
import com.jim.realcash.domain.parser.DefaultRules
import com.jim.realcash.ui.Strings
import kotlin.time.Duration
import kotlin.time.Instant
import kotlinx.datetime.DayOfWeek
import kotlinx.datetime.LocalDate
import kotlinx.datetime.TimeZone
import kotlinx.datetime.isoDayNumber
import kotlinx.datetime.number
import kotlinx.datetime.toLocalDateTime

/** Groups the digits of [value] by thousands: `12000` -> `12,000`, `-1500` -> `-1,500`. */
fun groupThousands(value: Long): String {
    val digits = if (value < 0) (-value).toString() else value.toString()
    val sb = StringBuilder(digits.length + digits.length / 3)
    digits.forEachIndexed { i, c ->
        if (i > 0 && (digits.length - i) % 3 == 0) sb.append(',')
        sb.append(c)
    }
    return if (value < 0) "-$sb" else sb.toString()
}

/** UI form of an amount: `₩12,000`; negative amounts as `-₩1,500`. */
fun Won.formatted(): String = if (value < 0) "-₩${groupThousands(-value.toLong())}" else "₩${groupThousands(value.toLong())}"

/** Face value label of a denomination without currency sign: `50,000`, `500`. */
val Denomination.faceLabel: String get() = groupThousands(won.toLong())

/** Helpers for the digits-only amount field. */
object AmountInput {
    /** Maximum number of digits accepted (99,999,999원), well inside [Int] range. */
    const val MAX_DIGITS: Int = 8

    /** Keeps only ASCII digits, drops leading zeros and truncates to [MAX_DIGITS]. */
    fun sanitize(text: String): String = text.filter { it in '0'..'9' }.trimStart('0').take(MAX_DIGITS)

    /** The amount typed as [digits] (output of [sanitize]); `null` when empty. */
    fun parse(digits: String): Won? = digits.toIntOrNull()?.let(::Won)
}

/**
 * Shows a digits-only field value with thousands separators (`100000` -> `100,000`) while the underlying text
 * stays digits only. The cursor mapping skips the inserted commas.
 */
object ThousandsSeparatorTransformation : VisualTransformation {
    override fun filter(text: AnnotatedString): TransformedText {
        val digits = text.text
        val n = digits.length
        val grouped = if (n == 0) "" else groupThousands(digits.toLong())
        val mapping = object : OffsetMapping {
            override fun originalToTransformed(offset: Int): Int = offset + commasBefore(n, offset)

            override fun transformedToOriginal(offset: Int): Int =
                offset - grouped.take(offset.coerceIn(0, grouped.length)).count { it == ',' }
        }
        return TransformedText(AnnotatedString(grouped), mapping)
    }

    /**
     * Number of commas at or before original cursor position [offset] in an [n]-digit string: a comma sits in front
     * of digit `i` (0 < i < n) when `(n - i) % 3 == 0`, and a cursor at `i` is placed after that comma.
     */
    internal fun commasBefore(n: Int, offset: Int): Int = (1..minOf(offset, n - 1)).count { (n - it) % 3 == 0 }
}

/** Remaining time for a hand: `5시간 12분 남음`, `12분 남음`, `1분 미만 남음`, or `만료됨`. */
fun formatRemaining(remaining: Duration): String {
[A] 용돈 받기 ──▶ [B] 꺼내기(계획) ──▶ [C] 결제(평소대로) ──▶ [D] 자동 감지 ──▶ [E] 거스름돈 ──▶ [G] 주간 마감
                        │                                           │
                        └── 안 꺼내고 결제 ────────────────────────┘ (자동 차감, "직접 꺼내지 않은 결제" 표시)
                                                [F] 환전 (언제든, 사용자 명시)
```

**[A] 용돈 받기 (Allowance)**
- 기간(주/월)과 예산을 정하면 **권종 조합을 사용자가 고른다.** ATM 처럼: "5만원권 2장 + 1만원권 5장 + 5천원권 2장".
- 이 조합이 그대로 지갑에 들어간다. 이후 앱은 이 지폐들을 절대 자동 재편성하지 않는다.
- 이월 정책: 기간 종료 시 남은 지폐는 (1) 다음 기간으로 그대로 이월 (2) 저금통으로 이동 — 사용자가 선택.

**[B] 꺼내기 (Hand / 손에 들기) — HardPay 그릇의 진화형**
- 시점: **집에서 나가기 전, 매장을 둘러보는 중, 장바구니에 담는 중.** 카운터가 아니다.
- 예상 금액을 입력하거나, 그냥 지폐를 드래그해서 "손에 든다".
- 부족하면 즉시 피드백: "지갑에 1만 2천원 남았어요. 5천원 부족".
- 손에 든 상태는 영속화되고 TTL 을 가진다(예: 6시간). 결제가 감지되지 않으면 지갑으로 자동 복귀 + 알림 "쓰지 않은 3만원을 지갑에 다시 넣었어요".
- 잠금화면 위젯 / Live Activity 에 "손에 든 돈 ₩30,000" 표시. 매장에서 폰을 꺼내도 결제 앱을 보는 것처럼 자연스럽다.

**[C] 결제 (Pay)**
- 사용자는 삼성페이/애플페이/실물카드로 평소처럼 결제. RealCash 는 아무것도 하지 않는다.

**[D] 자동 감지 (Detect)**
- 결제 알림(삼성월렛, 토스, 카드사 앱)을 읽어 금액·가맹점·시각을 파싱.
- 손에 든 금액과 매칭:
  - 정확히 일치 → 자동 정산. 알림: "정산 완료. 스타벅스 ₩6,500".
  - 손에 든 돈 > 결제액 → 거스름돈 계산 후 자동 정산. 알림: "거스름돈 ₩3,500 을 지갑에 넣었어요".
  - 손에 든 돈 < 결제액 → 부족분을 지갑에서 자동으로 꺼냄(큰 권종부터) + 거스름돈. 알림에 "지갑에서 1만원권 1장을 추가로 꺼냈어요" 명시.
  - 손에 든 돈 없음 → 지갑에서 자동 차감. 이 결제는 **"직접 꺼내지 않은 결제"** 뱃지가 붙고, 다음 홈 진입 시 어떤 지폐가 나갔는지 애니메이션으로 보여준다. (편의와 마찰의 균형: 자동이지만 숨기지 않는다)
  - 파싱 신뢰도 낮음 → 알림 액션 "맞아요 / 아니에요" 로 확인. 앱 진입 불필요.
- 중복 제거: 삼성월렛 푸시 + 카드사 푸시가 같은 결제로 두 번 올 수 있음. 금액 + 시간창(예: 2분) + 가맹점 유사도로 dedupe.
- 취소/환불 알림: 역방향 정산(지폐를 거스름돈 규칙으로 다시 지갑에).

**[E] 거스름돈 (Change)**
- 거스름돈은 **최소 개수 권종 조합** 으로 들어온다(실제 가게가 주는 방식). 원화 권종은 canonical 하므로 greedy 가 최적.
- 결과적으로 큰 지폐가 사라지고 잔돈이 쌓인다 → "지폐가 깨지는 고통" 이 자연 발생.
- 잔돈이 많이 쌓이면 다음 꺼내기에서 "잔돈으로 딱 맞춰 내기" 를 제안(현금 사용자가 실제로 하는 행동).

**[F] 환전 (Exchange)**
- 5만원권 1장 → 1만원권 5장 같은 교환을 사용자가 명시적으로 수행. 자동 아님.
- 사용자가 말한 "귀찮지만 아날로그 감성 재미" 가 여기다. 환전 UI 자체를 조금 번거롭게(은행 창구 느낌) 만드는 것도 의도적 마찰로서 선택지.

**[G] 주간/월간 마감 (Review)**
- 기간 끝에 지갑을 펼쳐 보여준다: 남은 지폐, 깨진 큰 지폐 수, "직접 꺼내지 않은 결제" 비율, 꺼낸 금액 vs 실제 금액 괴리(HardPay 에서 계승한 데이터).
- 남은 돈 이월 or 저금통.

### 3.4 눈치 문제(피드백 1) 재검증

- 결제 직전 개입이 사라졌으므로 구조적으로 해결.
- 매장에서 폰을 꺼내 보는 순간이 남는다면(예상 금액 맞춰 꺼내기), 그건 "결제 앱 확인" 과 구분되지 않는다. 위젯/Live Activity 로 앱 진입 없이 확인 가능하게 하면 더 줄어든다.

### 3.5 "그냥 결제" 모드가 너무 편해지는 리스크

- 안 꺼내고 결제해도 자동으로 차감되면 현금 효과가 희석될 수 있다.
- 대응: (1) 자동 차감은 **큰 권종부터** 꺼내서 거스름돈이 잔뜩 생기게 한다(의도적 불편) (2) 홈 진입 시 반드시 "지난 결제에서 나간 지폐" 애니메이션을 본다 (3) 주간 마감에서 "직접 꺼낸 비율" 을 보여준다. 마찰을 **결제 순간이 아닌 다른 순간으로 재배치** 하는 것이다.

### 3.6 나중 아이디어 (Phase 3+)

- **봉투 예산법(envelope budgeting)**: 식비 봉투, 커피 봉투처럼 지갑을 여러 봉투로 나눔. 현금 사용자의 실제 관행이고 지폐 개체 모델 위에 자연스럽게 올라간다.

