    private fun render(
        name: String,
        dark: Boolean = false,
        height: Int = HEIGHT,
        midway: (() -> Unit)? = null,
        interact: ((ImageComposeScene) -> Unit)? = null,
        content: @Composable () -> Unit,
    ) {
        val scene = ImageComposeScene(WIDTH * SCALE, height * SCALE, Density(SCALE.toFloat())) {
            RealCashTheme(darkTheme = dark, content = content)
        }
        try {
            // Advance the frame clock so enter animations (sheet, ripples) settle before the final frame.
            var t = 0L
            repeat(40) { frame ->
                if (frame == 20) {
                    midway?.invoke()
                    interact?.invoke(scene)
                }
                scene.render(t)
                t += FRAME_NANOS
            }
            val image = scene.render(t)
            val png = checkNotNull(image.encodeToData(EncodedImageFormat.PNG)) { "PNG encoding failed" }.bytes
            val file = File(outDir, "$name.png")
            file.writeBytes(png)
            println("screenshot: ${file.absolutePath}")
            assertTrue(file.length() > 0, "empty screenshot $name")
        } finally {
            scene.close()
        }
    }

    private companion object {
        const val WIDTH = 390
        const val HEIGHT = 844
        const val SCALE = 2
        const val FRAME_NANOS = 50_000_000L
    }
}
 * @property title row title, also used by the screen's own header.
 * @property description one line under the title.
 * @property content the screen; call `onBack` from its back button.
 */
class DebugEntry(
    val title: String,
    val description: String? = null,
    val content: @Composable (onBack: () -> Unit) -> Unit,
)

/** Pushed screen showing `platformDebugEntries[index]` (declared here, next to [DebugEntry]; part of [Screen]). */
data class PlatformDebugScreen(val index: Int) : Screen

/**
 * Everything below the theme, driven by an existing [appState]. Used by [RealCashApp] and by the screenshot tests,
 * which prepare the back stack and the sheet before rendering.
 */
@OptIn(ExperimentalMaterial3Api::class, ExperimentalComposeUiApi::class)
@Composable
fun RealCashRoot(
    appState: AppState,
    showDebugShortcut: Boolean = false,
    modifier: Modifier = Modifier,
    platformDebugEntries: List<DebugEntry> = emptyList(),
) {
    LaunchedEffect(appState) {
        appState.env.messages.messages.collect { appState.snackbarHostState.showSnackbar(it) }
    }
    // The platform back event (Android back button / gesture) pops the back stack; at the home
    // it is not consumed, so the system handles it. No-op where the platform sends no back events (desktop window).
    BackHandler(enabled = appState.canGoBack) { appState.back() }
    CompositionLocalProvider(LocalMoneyArt provides ResourceMoneyArt) {
        Scaffold(
            modifier = modifier,
            containerColor = MaterialTheme.colorScheme.background,
            snackbarHost = { SnackbarHost(appState.snackbarHostState) },
        ) { padding ->
            Box(Modifier.fillMaxSize().padding(padding)) {
                when (val screen = appState.current) {
                    Screen.WalletHome, Screen.WalletOpen -> WalletScene(appState, showDebugShortcut)
                    Screen.Ledger -> LedgerScreen(appState.ledger, appState.env.timeZone, onBack = { appState.back() })
                    Screen.Settings -> SettingsScreen(
                        model = appState.settings,
                        onBack = { appState.back() },
                        onOpenSimulator = { appState.navigate(Screen.NotificationSimulator) },
                        platformEntries = platformDebugEntries,
                        onOpenPlatformEntry = { index -> appState.navigate(PlatformDebugScreen(index)) },
                    )
                    Screen.ReceiveAllowance -> {
                        val model = remember { appState.receiveAllowance }
                        ReceiveAllowanceScreen(model, onBack = { appState.back() })
                    }
                    Screen.NotificationSimulator -> NotificationSimulatorScreen(appState.simulator, onBack = { appState.back() })
                    is Screen.TakeOut -> {
                        val model = remember(screen) { appState.takeOut }
                        TakeOutScreen(model, onBack = { appState.back() })
                    }
                    Screen.Exchange -> {
                        val model = remember { appState.exchange }
                        ExchangeScreen(model, onBack = { appState.back() })
                    }
                    is PlatformDebugScreen -> platformDebugEntries.getOrNull(screen.index)?.content?.invoke { appState.back() }
                }
            }
        }
        if (appState.confirmSheetOpen) {
            ConfirmPaymentsSheet(appState.confirmPayments, onDismiss = appState::closeConfirmSheet)
        }
        if (appState.manualSheetOpen) {
            ManualPaymentSheet(appState.manualPayment, onDismiss = appState::closeManualSheet, snackbarHostState = appState.snackbarHostState)
        }
    }
}

/** Keeps both wallet faces alive during the open/close transition. */
@Composable
private fun WalletScene(appState: AppState, showDebugShortcut: Boolean) {
    val open = appState.current == Screen.WalletOpen
    val transition = updateTransition(open, label = "wallet")
    val opening by transition.animateFloat(
        transitionSpec = { tween(durationMillis = if (targetState) 360 else 220) },
        label = "wallet-opening",
    ) { if (it) 1f else 0f }
    Box(Modifier.fillMaxSize()) {
        if (opening < 1f) {
            WalletHomeScreen(
                model = appState.walletHome,
                onReceiveAllowance = { appState.navigate(Screen.ReceiveAllowance) },
                onOpenPending = appState::openConfirmSheet,
                onOpenWallet = appState::openWallet,
                opening = opening,
                enabled = !open,
                modifier = Modifier.graphicsLayer { alpha = 1f - opening },
                menu = { WalletMenu(appState, showDebugShortcut) },
            )
        }
        if (open) {
            WalletOpenScreen(
                model = appState.walletOpen,
                onBack = { appState.back() },
                onManualPayment = appState::openManualSheet,
                modifier = Modifier.graphicsLayer { alpha = opening },
            )
        }
    }
}

/** All secondary destinations live in this menu; settings retains the platform debug entries. */
@Composable
private fun WalletMenu(appState: AppState, showDebugShortcut: Boolean) {
    var expanded by remember { mutableStateOf(false) }
    fun choose(action: () -> Unit) {
        expanded = false
        action()
    }
    Box {
        IconButton(onClick = { expanded = true }, modifier = Modifier.semantics { contentDescription = Strings.HOME_MENU }) {
            RcIconGlyph(RcIcon.MORE)
        }
        DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
            DropdownMenuItem(text = { Text(Strings.RECEIVE_ALLOWANCE) }, onClick = { choose { appState.navigate(Screen.ReceiveAllowance) } })
            DropdownMenuItem(text = { Text(Strings.EXCHANGE) }, onClick = { choose { appState.navigate(Screen.Exchange) } })
            DropdownMenuItem(text = { Text(Strings.MANUAL_TITLE) }, onClick = { choose(appState::openManualSheet) })
            DropdownMenuItem(text = { Text(Strings.TAB_LEDGER) }, onClick = { choose { appState.navigate(Screen.Ledger) } })
            DropdownMenuItem(text = { Text(Strings.TAB_SETTINGS) }, onClick = { choose { appState.navigate(Screen.Settings) } })
            if (showDebugShortcut) {
                DropdownMenuItem(text = { Text(Strings.SIMULATOR_SHORTCUT) }, onClick = { choose { appState.navigate(Screen.NotificationSimulator) } })
            }
            DropdownMenuItem(text = { Text("꺼내기") }, onClick = { choose { appState.navigate(Screen.TakeOut(refill = true)) } })
        }
    }
}
package com.jim.realcash.domain.ledger

import com.jim.realcash.domain.model.CashUnit
import com.jim.realcash.domain.model.CashUnitId
import com.jim.realcash.domain.model.CashUnitState
import com.jim.realcash.domain.model.Denomination
import com.jim.realcash.domain.model.DetectedPayment
import com.jim.realcash.domain.model.Hand
import com.jim.realcash.domain.model.PaymentId
import com.jim.realcash.domain.model.Settlement
import com.jim.realcash.domain.model.Won
import com.jim.realcash.domain.model.total

/** Wallet state derived from the ledger. Never stored as the source of truth. */
data class WalletState(
    /** Every unit ever seen, in any state (except units removed by [Adjusted]). */
    val units: Map<CashUnitId, CashUnit>,
    /** The currently active hand, if any. */
    val activeHand: Hand?,
    /** Detected payments waiting for confirmation or settlement. */
    val pendingPayments: Map<PaymentId, DetectedPayment>,
    /** Settlements in the order they were applied. */
    val settlements: List<Settlement>,
    /**
     * Identifiers of every applied event.
     *
     * NOTE: not in the original spec; added so that applying the same event twice is always rejected,
     * even for events whose effect would otherwise be a no-op.
     */
    val appliedEventIds: Set<String> = emptySet(),
) {
    /** Units currently in the wallet. */
    val inWallet: List<CashUnit> get() = units.values.filter { it.state == CashUnitState.IN_WALLET }

    /** Units currently held in the active hand. */
    val inHand: List<CashUnit> get() = units.values.filter { it.state == CashUnitState.IN_HAND }

    /** Money the user still owns in cash: wallet plus hand. Never negative. */
    val balance: Won get() = inWallet.total() + inHand.total()

    /** Number of units per denomination in the given [state], largest denomination first, zeros omitted. */
    fun countsByDenomination(state: CashUnitState): Map<Denomination, Int> {
        val counts = units.values.filter { it.state == state }.groupingBy { it.denomination }.eachCount()
        return Denomination.descending.filter { it in counts }.associateWith { counts.getValue(it) }
    }

    /**
     * Returns the list of violated invariants (empty when the state is consistent).
     *
     * The reducer keeps these invariants by construction; this full check is O(n) and meant for tests
     * and debug assertions rather than for every event.
     */
    fun invariantViolations(): List<String> {
        val problems = mutableListOf<String>()
        units.forEach { (key, unit) ->
            if (key != unit.id) problems += "unit stored under foreign key: $key -> ${unit.id}"
        }
        val handIds = activeHand?.unitIds.orEmpty()
        if (handIds.size != handIds.toSet().size) problems += "active hand lists a unit twice"
        val inHandIds = inHand.map { it.id }.toSet()
        if (inHandIds != handIds.toSet()) {
            problems += "IN_HAND units $inHandIds differ from active hand units ${handIds.toSet()}"
        }
        if (activeHand != null && handIds.isEmpty()) problems += "active hand holds no units"
        if (balance.value < 0) problems += "negative balance $balance"
        settlements.forEach { s ->
            if (s.shortfall.value < 0) problems += "negative shortfall in ${s.paymentId}"
            s.paidUnitIds.forEach { id ->
                if (units[id]?.state != CashUnitState.SPENT) problems += "paid unit $id is not SPENT"
            }
        }
        if (settlements.map { it.paymentId }.toSet().size != settlements.size) problems += "payment settled twice"
        settlements.forEach { s ->
            if (s.paymentId in pendingPayments) problems += "settled payment ${s.paymentId} still pending"
        }
        return problems
    }

    /** Factory for the initial state. */
    companion object {
        /** A wallet before any event has been applied. */
        val EMPTY: WalletState = WalletState(
            units = emptyMap(),
            activeHand = null,
            pendingPayments = emptyMap(),
            settlements = emptyList(),
        )
    }
}
