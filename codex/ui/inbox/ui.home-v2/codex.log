    fun e_confirmPaymentsSheet() = runBlocking {
        val data = newData().apply {
            seedAllowance()
            seedHand(W10000, W5000)
            seedPending()
        }
        val app = newAppState(data)
        app.openConfirmSheet()
        render("e-confirm-payments") { RealCashRoot(app) }
    }

