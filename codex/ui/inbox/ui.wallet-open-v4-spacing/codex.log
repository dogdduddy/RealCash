/**
 * Relative physical size: bills by width (154/148/142/136 mm), coins by diameter (26.5/24/21.6/18 mm),
 * normalised to the largest of their kind. Identification is color + numeral + size (design doc §5.5).
 */
val Denomination.relativeSize: Float
    get() = when (this) {
        Denomination.W50000, Denomination.W10000, Denomination.W5000, Denomination.W1000 -> billAspectRatio / BILL_ASPECT
        Denomination.C500 -> 1f
        Denomination.C100 -> 24f / 26.5f
        Denomination.C50 -> 21.6f / 26.5f
        Denomination.C10 -> 18f / 26.5f
    }

/** Width / height ratio of the largest bill (154 × 68 mm). */
const val BILL_ASPECT: Float = 154f / 68f

/** Physical face ratio; coins are square. The reviewed PNGs have these proportions within pixel rounding. */
val Denomination.billAspectRatio: Float
    get() = when (this) {
        Denomination.W50000 -> BILL_ASPECT
        Denomination.W10000 -> 148f / 68f
        Denomination.W5000 -> 142f / 68f
        Denomination.W1000 -> 136f / 68f
        else -> 1f
    }

private val BillCorner = 6.dp

/** Below this face height the small corner numeral is unreadable and is left out (chips, stepper rows). */
private val MIN_HEIGHT_FOR_CORNER_LABEL = 36.dp

data class WalletOpenLayout(val wallet: WalletRect, val pocket: WalletRect, val tray: WalletRect, val trayInner: WalletRect, val coins: WalletRect) {
    companion object {
        fun calculate(width: Float, height: Float): WalletOpenLayout {
            require(width > 0 && height > 0)
            val landscape = width > height
            val trayWidth = minOf(width * (if (landscape) 0.43f else 0.92f), height * (if (landscape) 0.30f else 0.22f) * 1024f / 427f)
            val tray = WalletRect(if (landscape) 12f else (width - trayWidth) / 2f, 78f, trayWidth, trayWidth * 427f / 1024f)
            val walletHeight = if (landscape) height - tray.top - 12f
                else minOf(height * 0.55f, height - tray.bottom - 42f)
            val walletWidth = walletHeight * 640f / 1230f
            val wallet = WalletRect(if (landscape) tray.right + 24f else 12f,
                if (landscape) tray.top else minOf(height - walletHeight - 12f, tray.bottom + 104f), walletWidth, walletHeight)
            // pocket.left is the vertical clipping line, not the hidden left edge of a full note.
            val coinLeft = width - CoinScatter.EDGE_MARGIN - CoinScatter.MAX_DIAMETER - CoinScatter.JITTER
            val pocket = WalletRect(wallet.left + wallet.width * WalletOpening.X,
                wallet.top + wallet.height * WalletOpening.TOP,
                coinLeft - CoinScatter.GAP - (wallet.left + wallet.width * WalletOpening.X),
                wallet.height * (WalletOpening.BOTTOM - WalletOpening.TOP))
            val all = pocketBillGroups(Denomination.descending.filter { it.kind == Denomination.Kind.BILL }
                .associateWith { 30 }, pocket)
            val coinStripLeft = maxOf(wallet.right, all.maxOf { it.right }) + CoinScatter.GAP
            // Include horizontal jitter in the strip and leave room below for the overflow button.
            return WalletOpenLayout(wallet, pocket, tray, tray.inner(0.05f, 0.13f, 0.95f, 0.90f),
                WalletRect(coinStripLeft, pocket.top,
                    width - CoinScatter.EDGE_MARGIN + CoinScatter.JITTER - coinStripLeft,
                    height - 56f - pocket.top))
        }
    }
}

/** One flat bundle: expensive notes underneath, with fixed denomination heads and real length ratios. */
fun pocketBillGroups(counts: Map<Denomination, Int>, pocket: WalletRect): List<PocketBillGroup> {
    if (pocket.width <= 0f || pocket.height <= 0f) return emptyList()
    val walletHeight = pocket.height / (WalletOpening.BOTTOM - WalletOpening.TOP)
    // Fit the lowest denomination and its deepest stack inside the pocket. Coins now sit beside it.
    val longest = minOf(walletHeight * 0.8f,
        (pocket.height - 3f * WalletOpening.HEAD_STEP - WalletOpening.MAX_STACK_OFFSET) / (136f / 154f),
        (pocket.width - WalletOpening.MAX_STACK_OFFSET) / 0.55f * Denomination.W50000.billAspectRatio,
    ).coerceAtLeast(1f)
    val shortEdge = longest / Denomination.W50000.billAspectRatio
    return Denomination.descending.filter { it.kind == Denomination.Kind.BILL }.mapIndexedNotNull { index, d ->
        val count = counts[d] ?: 0
        if (count <= 0) return@mapIndexedNotNull null
        val fraction = when (d) {
            Denomination.W1000 -> 0.55f
            Denomination.W5000 -> 0.45f
            Denomination.W10000 -> 0.35f
            else -> 0.25f
        }
        val exposed = shortEdge * fraction
        val step = if (count == 1) 0f else minOf(WalletOpening.PAPER_STEP, WalletOpening.MAX_STACK_OFFSET / (count - 1))
        PocketBillGroup(d, count, pocket.left + exposed - shortEdge,
            pocket.top + index * WalletOpening.HEAD_STEP, shortEdge, shortEdge * d.billAspectRatio,
            step, pocket.left, exposed)
    }
}

/** Only the stepped head is pickable below another denomination; the top group exposes its face. */
fun pocketBillHitBounds(groups: List<PocketBillGroup>, index: Int): WalletRect {
    val group = groups[index]
    val bottom = groups.getOrNull(index + 1)?.top ?: group.bottom
    return WalletRect(group.openingX, group.top - WalletOpening.HIT_PADDING,
        group.right - group.openingX, bottom - group.top + 2f * WalletOpening.HIT_PADDING)
}

/** Subtract front papers to give swipe contact only to paper the finger can actually see. */
internal fun visiblePaperBounds(groups: List<PocketBillGroup>): List<Triple<Denomination, Int, List<WalletRect>>> {
    val paint = groups.flatMap { group -> group.drawOrder().map { Triple(group.denomination, it, group.exposedBillBounds(it)) } }
    return paint.mapIndexed { i, paper ->
        var pieces = listOf(paper.third)
package com.jim.realcash.ui.walletopen

import kotlin.math.hypot
import kotlin.random.Random

/** Centre coordinates and clockwise angle. Unplaced overflow is deliberately excluded, never overlapped. */
data class ScatteredCoin(val index: Int, val x: Float, val y: Float, val diameter: Float, val rotation: Float)

object CoinScatter {
    const val MAX_DIAMETER = 34f
    const val EDGE_MARGIN = 12f
    const val JITTER = 3f
    const val GAP = 6f

    fun place(seed: Int, count: Int, area: WalletRect, diameter: Float = MAX_DIAMETER): List<ScatteredCoin> =
        place(seed, List(count.coerceAtLeast(0)) { diameter }, area)

    /** Rightmost column first; a second column is allowed only inside the paper-free strip. */
    fun place(seed: Int, diameters: List<Float>, area: WalletRect): List<ScatteredCoin> {
        require(diameters.all { it > 0f && it.isFinite() })
        val largest = diameters.maxOrNull() ?: return emptyList()
        if (area.width + 0.001f < largest + 2f * JITTER || area.height <= 0f) return emptyList()
        val random = Random(seed)
        val pitch = largest + GAP + 2f * JITTER
        val rightCenter = area.right - JITTER - largest / 2f
        var column = 0
        var top = area.top
        return buildList {
            diameters.forEachIndexed { index, diameter ->
                if (diameter > area.height) return@forEachIndexed
                if (top + diameter > area.bottom) {
                    column++
                    top = area.top
                }
                val center = rightCenter - column * pitch
                if (column >= 2 || center - largest / 2f - JITTER < area.left - 0.001f) return@forEachIndexed
                add(ScatteredCoin(index, center + (random.nextFloat() * 2f - 1f) * JITTER,
                    top + diameter / 2f, diameter, random.nextFloat() * 360f))
                top += diameter + GAP
            }
        }
    }
}

/** A floor drop preserves its exact centre, or springs back if it hits art, an edge or another coin. */
internal fun floorCoinTarget(
    pointer: androidx.compose.ui.geometry.Offset,
    diameter: Float,
    floor: WalletRect,
    wallet: WalletRect,
    tray: WalletRect,
    occupied: List<WalletRect>,
): WalletRect? {
    val target = WalletRect(pointer.x - diameter / 2f, pointer.y - diameter / 2f, diameter, diameter)
    if (target.left < floor.left || target.right > floor.right || target.top < floor.top || target.bottom > floor.bottom) return null
    fun overlapsArt(rect: WalletRect) = target.left < rect.right && target.right > rect.left && target.top < rect.bottom && target.bottom > rect.top
    if (overlapsArt(wallet) || overlapsArt(tray)) return null
    if (occupied.any { hypot(pointer.x - it.center.x, pointer.y - it.center.y) < (diameter + it.width) / 2f + 1f }) return null
    return target
}
