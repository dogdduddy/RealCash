        assertNull(floorCoinTarget(Offset(2f, 600f), 34f, floor, layout.wallet, layout.tray, emptyList()))
        assertNull(floorCoinTarget(left + Offset(30f, 0f), 34f, floor, layout.wallet, layout.tray, listOf(target)))
    }

