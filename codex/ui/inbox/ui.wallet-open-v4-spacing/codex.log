        scaleY = lift.value + ((targetH ?: pick.faceHeight) / pick.faceHeight - lift.value) * p
        shadowElevation = (18f * (1f - p.coerceIn(0f, 1f)) + 2f).dp.toPx()
    }.semantics { contentDescription = "${pick.unit.denomination.faceLabel}원 집어서 이동 중" })
